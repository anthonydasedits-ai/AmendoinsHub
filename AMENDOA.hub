	if bypassActive then
		bypassActive = false
		byStatusLbl.Text = "STATUS: DESATIVADO"; byStatusLbl.TextColor3 = COLOR_BROWN
		byBtn.Text = "ATIVAR BYPASS"; byBtn.BackgroundColor3 = COLOR_PEANUT_DARK
