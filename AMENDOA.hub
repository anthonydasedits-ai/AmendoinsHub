-- ===== Toggle =====
local function createToggle(parent, text, position)
	local frame = Instance.new("Frame")
	frame.Name = "Toggle_" .. text:gsub("%s+", "_")
	frame.Size = UDim2.new(1, -16, 0, 30)
	frame.Position = position or UDim2.new(0, 8, 0, 8)
	frame.BackgroundTransparency = 1
	frame.ZIndex = 5
	frame.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -60, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = COLOR_BROWN
	label.Font = Enum.Font.GothamBold
	label.TextSize = 14
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.ZIndex = 5
	label.Parent = frame

	local switch = Instance.new("TextButton")
	switch.Name = "Switch"
	switch.Size = UDim2.new(0, 42, 0, 22)
	switch.Position = UDim2.new(1, -42, 0.5, -11)
	switch.BackgroundColor3 = COLOR_PEANUT_DARK
	switch.Text = ""
	switch.AutoButtonColor = false
	switch.ZIndex = 5
	switch.Parent = frame

	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(1, 0)
	sCorner.Parent = switch

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 2, 0.5, -9)
	knob.BackgroundColor3 = COLOR_HIGHLIGHT
	knob.ZIndex = 6
	knob.Parent = switch

	local kCorner = Instance.new("UICorner")
	kCorner.CornerRadius = UDim.new(1, 0)
	kCorner.Parent = knob

	local state = false
	local callbacks = {}

	local function update()
		local targetColor = state and COLOR_GREEN or COLOR_PEANUT_DARK
		local targetPos = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
		switch.BackgroundColor3 = targetColor
		TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
	end

	switch.MouseButton1Click:Connect(function()
		state = not state
		update()
		for _, cb in ipairs(callbacks) do
			task.spawn(cb, state)
		end
	end)

	return {
		Frame = frame,
		Set = function(v) state = v; update() end,
		Get = function() return state end,
		OnChanged = function(cb) table.insert(callbacks, cb) end,
	}
end

