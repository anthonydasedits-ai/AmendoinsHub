local RARITY_SCORE = {
	["Light & Dark"]=1300,["Titan"]=1100,["Divine"]=1000,["Transcendent"]=1000,["Superior"]=1000,
	["Eternal"]=900,["Limited"]=900,["Secret"]=800,["Exotic"]=800,["Cosmic"]=700,["Exclusive"]=700,
	["Admin"]=700,["Mythic"]=600,["Mythical"]=600,["Prismatic"]=600,["Rainbow"]=600,["Squishy God"]=600,
	["BrainrotGod"]=600,["Legendary"]=500,["Epic"]=400,["Rare"]=300,["SuperRare"]=200,["Celestial"]=200,
	["Uncommon"]=200,["Basic"]=100,["Common"]=100,
}
local RARITY_COLOR = {
	["Light & Dark"]=Color3.fromRGB(255,100,255),["Titan"]=Color3.fromRGB(255,60,60),
	["Divine"]=Color3.fromRGB(255,240,120),["Transcendent"]=Color3.fromRGB(180,200,255),
	["Superior"]=Color3.fromRGB(255,180,80),["Eternal"]=Color3.fromRGB(120,220,255),
	["Limited"]=Color3.fromRGB(255,150,200),["Secret"]=Color3.fromRGB(255,60,60),
	["Exotic"]=Color3.fromRGB(180,255,100),["Cosmic"]=Color3.fromRGB(150,100,255),
	["Exclusive"]=Color3.fromRGB(255,200,60),["Admin"]=Color3.fromRGB(255,50,50),
	["Mythic"]=Color3.fromRGB(255,100,100),["Mythical"]=Color3.fromRGB(255,100,100),
	["Prismatic"]=Color3.fromRGB(255,150,255),["Rainbow"]=Color3.fromRGB(255,180,100),
	["Legendary"]=Color3.fromRGB(255,200,80),["Epic"]=Color3.fromRGB(180,100,255),
	["Rare"]=Color3.fromRGB(100,180,255),["Uncommon"]=Color3.fromRGB(100,255,150),
	["Common"]=Color3.fromRGB(200,200,200),
}

local iconCache, assetInfoCache, rarityNameCache = {}, {}, {}

local function getAssetInfo(cat)
	if not cat then return nil end
	if assetInfoCache[cat] ~= nil then return assetInfoCache[cat] end
	local info = AssetsData and (AssetsData.Directory or AssetsData)[cat]
	assetInfoCache[cat] = info or false
	return info or nil
end

local function getRarityName(record)
	if not record then return "Common" end
	local uid = record.Uid or record.BoundsCFrame
	if uid and rarityNameCache[uid] then return rarityNameCache[uid] end
	local name
	if record.Rarity then
		local r = record.Rarity
		name = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
	else
		local cat = record.AssetCategory or record.Category or record.Name
		local info = cat and getAssetInfo(cat)
		if info and info.Rarity then
			local r = info.Rarity
			name = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
		else
			local areaData = AreasData and (AreasData.Directory or AreasData) and (AreasData.Directory or AreasData)[record.AreaId]
			local rarity = areaData and areaData.Rarity
			local rarityId = (type(rarity)=="table" and (rarity._id or rarity.DisplayName or rarity.Name)) or (type(rarity)=="string" and rarity) or "Common"
			local rInfo = (RarityData and (RarityData.Rarities or RarityData) or {})[rarityId] or {}
			name = (type(rInfo)=="table" and (rInfo.DisplayName or rInfo._id)) or (type(rarity)=="table" and rarity.DisplayName) or rarityId or "Common"
		end
	end
	name = name or "Common"
	if uid then rarityNameCache[uid] = name end
	return name
end

local function mutationMultiplier(record)
	local m = 1
	local muts = record.Mutations or record.Mutation
	if type(muts) == "table" then
		for _, mu in pairs(muts) do
			if type(mu) == "table" then
				m = m * (tonumber(mu.Multiplier or mu.Value or mu.Scale) or 1.5)
			else
				local t = tostring(mu):lower()
				if t:find("rainbow") then m = m * 3
				elseif t:find("gold") then m = m * 2
				elseif t:find("silver") then m = m * 1.5
				elseif t:find("parasite") or t:find("monstrous") then m = m * 5
				else m = m * 1.25 end
			end
		end
	elseif muts then m = m * 1.5 end
	if record.HasParasite then m = m * 5 end
	return m
end

local function getEggValue(record)
	local cat = tostring(record.AssetCategory or record.Category or record.Name or "Egg")
	local info = getAssetInfo(cat)
	local raw = tonumber(record.Income or record.EarningRate or record.MoneyPerSecond
		or record.MoneyPerSec or record.CashPerSecond or record.CPS
		or record.Money or record.Cash or record.Value or record.Price)
	if (not raw or raw <= 0) and type(info) == "table" then
		raw = tonumber(info.Income or info.EarningRate or info.MoneyPerSecond
			or info.MoneyPerSec or info.CashPerSecond or info.CPS
			or info.Money or info.Cash or info.ProfileIncome
			or info.SalePrice or info.Price)
		if (not raw or raw <= 0) and type(info.Egg) == "table" then
			raw = tonumber(info.Egg.Income or info.Egg.EarningRate or info.Egg.MoneyPerSecond
				or info.Egg.Money or info.Egg.Cash or info.Egg.SalePrice)
		end
	end
	raw = tonumber(raw) or 0
	local scale = tonumber(record.AssetScale or record.Scale or record.NestScale) or 1
	local value = raw * scale * mutationMultiplier(record)
	if value <= 0 then
		local rarity = getRarityName(record)
		local score = RARITY_SCORE[rarity] or 100
		local area = tonumber(tostring(record.AreaId or ""):match("%d+")) or 50
		value = score * math.max(area, 50) * math.max(scale, 1)
	end
	return value
end

local function formatarValor(v)
	v = tonumber(v) or 0
	if v >= 1e15 then return string.format("%.1fQ", v/1e15)
	elseif v >= 1e12 then return string.format("%.1fT", v/1e12)
	elseif v >= 1e9  then return string.format("%.1fB", v/1e9)
	elseif v >= 1e6  then return string.format("%.1fM", v/1e6)
	elseif v >= 1e3  then return string.format("%.1fK", v/1e3)
	else return string.format("%d", math.floor(v + 0.5)) end
end

local function getRarityColor(r) return RARITY_COLOR[r] or Color3.fromRGB(220,220,220) end

local ESPFolder = nil
local activeESP = {}
local espBindingName = "ESP_Ovos_Update"
local espRunning = false

local function criarESP(uid)
	local part = Instance.new("Part")
	part.Name = "ESP_" .. tostring(uid)
	part.Anchored = true; part.CanCollide = false; part.CanQuery = false; part.CanTouch = false
	part.Transparency = 1; part.Size = Vector3.new(0.1,0.1,0.1); part.Parent = ESPFolder

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0,150,0,48); bb.StudsOffset = Vector3.new(0,2.5,0)
	bb.AlwaysOnTop = true; bb.LightInfluence = 0; bb.MaxDistance = maxEspDistance; bb.Parent = part

	local c = Instance.new("Frame")
	c.Size = UDim2.new(1,0,1,0); c.BackgroundColor3 = Color3.fromRGB(15,15,20)
	c.BackgroundTransparency = 0.25; c.BorderSizePixel = 0; c.Parent = bb
	Instance.new("UICorner", c).CornerRadius = UDim.new(0,5)
	local s = Instance.new("UIStroke", c)
	s.Color = Color3.fromRGB(46,204,113); s.Thickness = 1; s.Transparency = 0.3

	local lN = Instance.new("TextLabel")
	lN.Size = UDim2.new(1,-12,0,13); lN.Position = UDim2.new(0,6,0,4)
	lN.BackgroundTransparency = 1; lN.TextColor3 = Color3.fromRGB(240,240,245)
	lN.Font = Enum.Font.GothamBold; lN.TextSize = 10; lN.TextXAlignment = Enum.TextXAlignment.Left
	lN.Text = "Ovo"; lN.Parent = c

	local lR = Instance.new("TextLabel")
	lR.Size = UDim2.new(1,-12,0,10); lR.Position = UDim2.new(0,6,0,17)
	lR.BackgroundTransparency = 1; lR.TextColor3 = Color3.fromRGB(200,200,200)
	lR.Font = Enum.Font.Gotham; lR.TextSize = 9; lR.TextXAlignment = Enum.TextXAlignment.Left
	lR.Text = "Common"; lR.Parent = c

	local lV = Instance.new("TextLabel")
	lV.Size = UDim2.new(1,-12,0,14); lV.Position = UDim2.new(0,6,0,29)
	lV.BackgroundTransparency = 1; lV.TextColor3 = Color3.fromRGB(255,210,80)
	lV.Font = Enum.Font.GothamBlack; lV.TextSize = 12; lV.TextXAlignment = Enum.TextXAlignment.Left
	lV.Text = "$0"; lV.Parent = c

	return {part=part,billboard=bb,stroke=s,labelNome=lN,labelRarity=lR,labelValor=lV,
		_lastNome="",_lastRarity="",_lastValor="",_lastColor=nil,_lastMaxDist=-1}
end

local function atualizarESP()
	if not EggState or not EggState.ReadFieldEggs then return end
	local ok, snap = pcall(EggState.ReadFieldEggs)
	if not ok or not snap or not snap.Records then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position
	local maxSq = maxEspDistance * maxEspDistance
	local cur = {}
	for _, rec in ipairs(snap.Records) do
		if rec.State == "Slot" and rec.BoundsCFrame then
			local p = rec.BoundsCFrame.Position
			local dx,dy,dz = p.X-myPos.X, p.Y-myPos.Y, p.Z-myPos.Z
			if dx*dx+dy*dy+dz*dz <= maxSq then
				local uid = rec.Uid or tostring(rec.BoundsCFrame)
				cur[uid] = true
				local esp = activeESP[uid]
				if not esp then esp = criarESP(uid); activeESP[uid] = esp end
				esp.part.CFrame = CFrame.new(p)
				local nm = tostring(rec.AssetCategory or rec.Category or rec.Name or "Ovo")
				if esp._lastNome ~= nm then esp.labelNome.Text = nm; esp._lastNome = nm end
				local rn = getRarityName(rec)
				if esp._lastRarity ~= rn then esp.labelRarity.Text = rn; esp._lastRarity = rn end
				local co = getRarityColor(rn)
				if esp._lastColor ~= co then esp.labelRarity.TextColor3 = co; esp.stroke.Color = co; esp._lastColor = co end
				local vt = "$" .. formatarValor(getEggValue(rec))
				if esp._lastValor ~= vt then esp.labelValor.Text = vt; esp._lastValor = vt end
				if esp._lastMaxDist ~= maxEspDistance then
					esp.billboard.MaxDistance = maxEspDistance
					esp._lastMaxDist = maxEspDistance
				end
			end
		end
	end
	for uid, esp in pairs(activeESP) do
		if not cur[uid] then esp.part:Destroy(); activeESP[uid] = nil end
	end
end

local function iniciarESP()
	if espRunning then return end
	espRunning = true
	if not ESPFolder or not ESPFolder.Parent then
		ESPFolder = Instance.new("Folder")
		ESPFolder.Name = "ESP_ListaOvos"
		ESPFolder.Parent = (gethui and gethui()) or Workspace
	end
	pcall(function() RunService:UnbindFromRenderStep(espBindingName) end)
	RunService:BindToRenderStep(espBindingName, Enum.RenderPriority.Camera.Value + 1, atualizarESP)
	task.spawn(function()
		while espRunning do
			task.wait(0.1)
			if espRunning then pcall(atualizarESP) end
		end
	end)
end

local function pararESP()
	if not espRunning then return end
	espRunning = false
	pcall(function() RunService:UnbindFromRenderStep(espBindingName) end)
	for uid, esp in pairs(activeESP) do esp.part:Destroy(); activeESP[uid] = nil end
	if ESPFolder then ESPFolder:Destroy(); ESPFolder = nil end
end

local espEggsToggle = createToggle(espContent, "ESP EGGS", UDim2.new(0, 8, 0, 8))
espEggsToggle.OnChanged(function(state)
	if state then iniciarESP() else pararESP() end
end)

