local function clearList()
	for _, item in ipairs(listItems) do item:Destroy() end
	listItems = {}
	hopScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
end

local function addMsg(msg, color)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -4, 0, 18)
	lbl.BackgroundTransparency = 1
	lbl.Text = msg
	lbl.TextColor3 = color or COLOR_PEANUT_DARK
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 10
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 10
	lbl.Parent = hopScroll
	table.insert(listItems, lbl)
	hopScroll.CanvasSize = UDim2.new(0, 0, 0, #listItems * 20)
end

local function setStatus(txt, color)
	hopStatus.Text = txt
	hopStatus.TextColor3 = color or COLOR_PEANUT_DARK
end

local function fetchServers()
	local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local ok, raw = httpGet(url)
	if not ok or not raw or raw == "" then return nil end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 or not data or not data.data then return nil end
	local currentId = tostring(game.JobId)
	local lista = {}
	for _, s in ipairs(data.data) do
		if s.id and tostring(s.id) ~= currentId and s.playing < s.maxPlayers then
			table.insert(lista, {
				id = tostring(s.id),
				playing = s.playing or 0,
				maxPlayers = s.maxPlayers or 0,
				ping = s.ping or 0,
			})
		end
	end
	table.sort(lista, function(a, b) return a.playing < b.playing end)
	return lista
end

local function verificarVaga(serverId)
	local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local ok, raw = httpGet(url)
	if not ok or not raw then return false, nil end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 or not data or not data.data then return false, nil end
	for _, s in ipairs(data.data) do
		if tostring(s.id) == tostring(serverId) then
			return (s.playing or 0) < (s.maxPlayers or 0), {
				id = tostring(s.id), playing = s.playing or 0, maxPlayers = s.maxPlayers or 0
			}
		end
	end
	return false, nil
end

local function tentarTeleport(lista, maxTentativas)
	maxTentativas = maxTentativas or 5
	local t = 0
	for _, s in ipairs(lista) do
		if t >= maxTentativas then break end
		t = t + 1
		local temVaga, dados = verificarVaga(s.id)
		if temVaga and dados then
			setStatus("Tentando " .. t .. ": " .. dados.playing .. "/" .. dados.maxPlayers, COLOR_PEANUT_DARK)
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(PlaceId, dados.id, LocalPlayer)
			end)
			if ok then return true, dados end
			task.wait(0.6)
		end
	end
	return false, nil
end

local function aplicarFiltro(lista)
	local opt = hopFiltroOpts[hopFiltroIdx]
	local out = {}
	for _, s in ipairs(lista) do
		if s.playing <= opt.max then table.insert(out, s) end
	end
	return out
end

local function renderServers(lista)
	clearList()
	if not lista or #lista == 0 then
		addMsg("Nenhum servidor com vaga.", COLOR_RED)
		return
	end
	for _, s in ipairs(lista) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 18)
		row.BackgroundColor3 = COLOR_PEANUT
		row.BackgroundTransparency = 0.25
		row.BorderSizePixel = 0
		row.ZIndex = 10
		row.Parent = hopScroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1, -50, 1, 0)
		info.Position = UDim2.new(0, 5, 0, 0)
		info.BackgroundTransparency = 1
		info.Text = string.format("%d/%d", s.playing, s.maxPlayers)
		info.TextColor3 = COLOR_BROWN
		info.Font = Enum.Font.GothamBold
		info.TextSize = 10
		info.TextXAlignment = Enum.TextXAlignment.Left
		info.ZIndex = 10
		info.Parent = row

		local joinBtn = Instance.new("TextButton")
		joinBtn.Size = UDim2.new(0, 40, 0, 14)
		joinBtn.Position = UDim2.new(1, -44, 0.5, -7)
		joinBtn.BackgroundColor3 = COLOR_PEANUT_DARK
		joinBtn.BorderSizePixel = 0
		joinBtn.Text = "JOIN"
		joinBtn.TextColor3 = COLOR_HIGHLIGHT
		joinBtn.Font = Enum.Font.GothamBold
		joinBtn.TextSize = 9
		joinBtn.AutoButtonColor = false
		joinBtn.ZIndex = 10
		joinBtn.Parent = row
		Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 4)

		joinBtn.MouseButton1Click:Connect(function()
			joinBtn.Text = "..."
			local temVaga, dados = verificarVaga(s.id)
			if not temVaga then
				joinBtn.Text = "CHEIO"
				setStatus("Server cheio.", COLOR_RED)
				task.wait(1.5)
				joinBtn.Text = "JOIN"
				return
			end
			setStatus("Entrando...", COLOR_PEANUT_DARK)
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(PlaceId, dados.id, LocalPlayer)
			end)
			if not ok then
				joinBtn.Text = "ERRO"
				task.wait(1.5)
				joinBtn.Text = "JOIN"
			end
		end)

		table.insert(listItems, row)
	end
	hopScroll.CanvasSize = UDim2.new(0, 0, 0, #lista * 20)
end

btnFiltro.MouseButton1Click:Connect(function()
	hopFiltroIdx = hopFiltroIdx + 1
	if hopFiltroIdx > #hopFiltroOpts then hopFiltroIdx = 1 end
	btnFiltro.Text = "Filtro: " .. hopFiltroOpts[hopFiltroIdx].label
	if #currentServers > 0 then renderServers(aplicarFiltro(currentServers)) end
end)

btnEnter.MouseButton1Click:Connect(function()
	btnEnter.Text = "Procurando..."
	setStatus("Buscando o mais vazio...", COLOR_PEANUT_DARK)
	task.wait(0.1)
	local lista = fetchServers()
	if not lista or #lista == 0 then
		setStatus("Nenhum server com vaga.", COLOR_RED)
		btnEnter.Text = "Entrar no Melhor"
		return
	end
	local filtrada = aplicarFiltro(lista)
	if #filtrada == 0 then filtrada = lista end
	setStatus("Teleportando (top 5)...", COLOR_PEANUT_DARK)
	local sucesso, dados = tentarTeleport(filtrada, 5)
	if sucesso then
		setStatus("Entrando em " .. dados.playing .. "/" .. dados.maxPlayers, COLOR_GREEN)
	else
		setStatus("Falha em todos os 5.", COLOR_RED)
	end
	btnEnter.Text = "Entrar no Melhor"
end)

btnLista.MouseButton1Click:Connect(function()
	btnLista.Text = "Buscando..."
	setStatus("Buscando servidores...", COLOR_PEANUT_DARK)
	task.wait(0.1)
	local lista = fetchServers()
	if not lista or #lista == 0 then
		setStatus("Nenhum server com vaga.", COLOR_RED)
		btnLista.Text = "Ver Lista de Servidores"
		return
	end
	currentServers = lista
	local filtrada = aplicarFiltro(lista)
	setStatus(#filtrada .. " servers. Clica JOIN.", COLOR_GREEN)
	btnLista.Text = "Ver Lista de Servidores"
	renderServers(filtrada)
end)

-- =====================================================
-- LÓGICA TREADMILL
-- =====================================================
local PlotState, TreadmillUtil, Remotes
pcall(function() PlotState = require(ReplicatedStorage.Client.PlotState) end)
pcall(function() TreadmillUtil = require(ReplicatedStorage.Shared.Util.TreadmillUtil) end)
pcall(function() Remotes = require(ReplicatedStorage.Shared.Remotes) end)

local tmAlive, tmFlying, tmTraining, tmBeltOn = true, false, false, false
local tmConns = {}
local function tmWatch(sig, fn)
	local c = sig:Connect(function(...) if tmAlive then fn(...) end end)
	tmConns[#tmConns + 1] = c
	return c
end

local function tmWalkSpeed()
	local ch = LocalPlayer.Character
	local h  = ch and ch:FindFirstChildOfClass("Humanoid")
	local speed = (h and h.WalkSpeed) or 16
	if TreadmillUtil then
		local ok, r = pcall(function()
			local ls = LocalPlayer:FindFirstChild("leaderstats")
			local st = ls and ls:FindFirstChild("Speed")
			return st and TreadmillUtil.SpeedPowerToWalkSpeed(st.Value) or nil
		end)
		if ok and type(r) == "number" and r > 0 then speed = math.min(speed, r) end
	end
	return speed
end

local function tmFrozenCamera()
	local cam = workspace.CurrentCamera
	if not cam then return function() end end
	local done, old, cf = false, cam.CameraType, cam.CFrame
	pcall(function() cam.CameraType = Enum.CameraType.Scriptable; cam.CFrame = cf end)
	return function()
		if done then return end
		done = true
		pcall(function() cam.CameraType = old end)
	end
end

local tmDangerCache, tmDangerAt = {}, 0
local function tmDangers()
	if os.clock() - tmDangerAt < 5 then return tmDangerCache end
	tmDangerAt = os.clock()
	local list = {}
	local function add(inst)
		local ok, cf, size = pcall(function()
			if inst:IsA("Model") then return inst:GetBoundingBox()
			elseif inst:IsA("BasePart") then return inst.CFrame, inst.Size end
		end)
		if ok and cf and size then
			local half = Vector3.new(math.abs(size.X), 0, math.abs(size.Z)) * 0.5
			local rx = math.abs(cf.RightVector.X) * half.X + math.abs(cf.LookVector.X) * half.Z
			local rz = math.abs(cf.RightVector.Z) * half.X + math.abs(cf.LookVector.Z) * half.Z
			list[#list + 1] = {
				MinX = cf.Position.X - rx, MaxX = cf.Position.X + rx,
				MinZ = cf.Position.Z - rz, MaxZ = cf.Position.Z + rz,
			}
		end
	end
	local function bad(name)
		if name == "ScrambleLocalVisuals" or name == "DrScrambleEvent" then return false end
		name = string.lower(name)
		return string.find(name, "portal", 1, true)
			or string.find(name, "teleport", 1, true)
			or string.find(name, "mech", 1, true)
			or string.find(name, "arena", 1, true)
			or string.find(name, "scramble", 1, true)
	end
	for _, ch in ipairs(workspace:GetChildren()) do
		if (ch:IsA("Model") or ch:IsA("BasePart") or ch:IsA("Folder")) and bad(ch.Name) then
			if ch:IsA("Folder") then for _, i in ipairs(ch:GetChildren()) do add(i) end
			else add(ch) end
		end
	end
	local build = workspace:FindFirstChild("World")
	build = build and build:FindFirstChild("Build")
	if build then
		for _, ch in ipairs(build:GetChildren()) do
			if bad(ch.Name) then for _, i in ipairs(ch:GetChildren()) do add(i) end end
		end
	end
	tmDangerCache = list
	return list
end

local function tmAvoid(from, to)
	for _, d in ipairs(tmDangers()) do
		local x0, x1, z0, z1 = d.MinX - 12, d.MaxX + 12, d.MinZ - 12, d.MaxZ + 12
		local inside = from.X >= x0 and from.X <= x1 and from.Z >= z0 and from.Z <= z1
		if not inside then
			local t0, t1, hit = 0, 1, true
			for _, ax in ipairs({ { from.X, to.X - from.X, x0, x1 }, { from.Z, to.Z - from.Z, z0, z1 } }) do
				local pos, delta, lo, hi = ax[1], ax[2], ax[3], ax[4]
				if math.abs(delta) < 1e-6 then
					if pos < lo or pos > hi then hit = false end
				else
					local ta, tb = (lo - pos) / delta, (hi - pos) / delta
					if ta > tb then ta, tb = tb, ta end
					t0, t1 = math.max(t0, ta), math.min(t1, tb)
					if t0 > t1 then hit = false end
				end
			end
			if hit then
				local zLow, zHigh = z0 - 2, z1 + 2
				local z = math.abs(from.Z - zLow) <= math.abs(from.Z - zHigh) and zLow or zHigh
				if z < -440 or z > -290 then z = z == zLow and zHigh or zLow end
				local x = math.abs(from.X - x0) <= math.abs(from.X - x1) and x0 or x1
				if math.abs(from.Z - z) < 3 then x = math.abs(to.X - x0) <= math.abs(to.X - x1) and x0 or x1 end
				return Vector3.new(x, to.Y, z)
			end
		end
	end
	return to
end

local function tmMySlot()
	if PlotState and type(PlotState.ResolveLocalSlot) == "function" then
		local ok, s = pcall(PlotState.ResolveLocalSlot)
		if ok and type(s) == "number" then return s end
	end
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, p in ipairs(plots:GetChildren()) do
		local sign = p:FindFirstChild("PlotSign")
		sign = sign and sign:FindFirstChild("PlayerPlotSign")
		local f = sign and sign:FindFirstChild("Frame")
		local n = f and f:FindFirstChild("PlayerName")
		if n and n:IsA("TextLabel")
			and (n.Text == LocalPlayer.DisplayName or n.Text == LocalPlayer.Name) then
			return tonumber(p.Name)
		end
	end
	return nil
end

local function tmTreadmillSpot(slot)
	local renders = workspace:FindFirstChild("__ClientTreadmillRenders")
	local tr = renders and renders:FindFirstChild("TreadmillRender_" .. tostring(slot))
	if tr then
		local r = tr:FindFirstChild("Root", true)
		if r and r:IsA("BasePart") then return r.Position end
	end
	local plot = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(tostring(slot))
	local b = plot and plot:FindFirstChild("TreadmillBottom")
	if b and b:IsA("BasePart") then return Vector3.new(b.Position.X, b.Position.Y + 4, b.Position.Z - 2) end
	return nil
end

local function tmRoot()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function tmHumanoid()
	local c = LocalPlayer.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local TM_CFG = { SpeedCap = 1.15, Height = 70, ClimbShare = 0.5 }
local function tmFlyTo(target, statusFn)
	local h, r = tmHumanoid(), tmRoot()
	if not r or not h then return false, "sem character" end
	h.PlatformStand = false
	pcall(function() h:UnequipTools() end)
	local releaseCam = tmFrozenCamera()
	local ws = tmWalkSpeed()
	local speed = math.max(ws * TM_CFG.SpeedCap, 8)
	local share = math.clamp(TM_CFG.ClimbShare, 0.1, 0.9)
	local cruiseY = math.max(r.Position.Y, target.Y + TM_CFG.Height)
	statusFn("subindo p/ cruzeiro...")
	local t0 = os.clock()
	while tmAlive and tmFlying and os.clock() - t0 < 15 do
		r, h = tmRoot(), tmHumanoid()
		if not r or not h then break end
		if r.Position.Y >= cruiseY - 2 then break end
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(0, math.min(speed * share, (cruiseY - r.Position.Y) / 0.12), 0)
			h:Move(Vector3.new(0, 0, 0), false)
		end)
		RunService.Heartbeat:Wait()
	end
	statusFn("voando p/ treadmill...")
	local last, lastPos = os.clock(), r.Position
	local start = os.clock()
	while tmAlive and tmFlying and os.clock() - start < 120 do
		r, h = tmRoot(), tmHumanoid()
		if not r or not h then return false, "perdeu character" end
		local flat = Vector3.new(target.X - r.Position.X, 0, target.Z - r.Position.Z)
		local dy = target.Y - r.Position.Y
		if flat.Magnitude < 3 and math.abs(dy) < 3 then break end
		local aim = tmAvoid(r.Position, target)
		local f2 = Vector3.new(aim.X - r.Position.X, 0, aim.Z - r.Position.Z)
		local unit = f2.Magnitude > 0.01 and f2.Unit or Vector3.zero
		local vy = math.clamp(dy / 0.12, -speed * share, speed * share)
		local horiz = math.sqrt(math.max(speed * speed - vy * vy, 0))
		local v = unit * math.min(horiz, f2.Magnitude / 0.05)
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
			if unit.Magnitude > 0 then h:Move(unit, false) end
		end)
		if os.clock() - last >= 1.5 then
			if (r.Position - lastPos).Magnitude < 3 and flat.Magnitude > 15 then
				pcall(function() h.Jump = true end)
			end
			lastPos, last = r.Position, os.clock()
		end
		RunService.Heartbeat:Wait()
	end
	releaseCam()
	r, h = tmRoot(), tmHumanoid()
	if r then pcall(function()
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
		if h then h:Move(Vector3.zero, false) end
	end) end
	return tmAlive and tmFlying
end

