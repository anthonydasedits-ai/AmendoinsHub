-- helpers de UI para outras abas
local function mkSection(parent, text, y)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1,-16,0,16); lbl.Position = UDim2.new(0,8,0,y)
	lbl.BackgroundTransparency = 1; lbl.Text = string.upper(text)
	lbl.TextColor3 = COLOR_PEANUT_DARK; lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 10; lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 9; lbl.Parent = parent
	return y + 18
end

local function mkInput(parent, placeholder, initial, y, onEnter)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1,-16,0,22); box.Position = UDim2.new(0,8,0,y)
	box.BackgroundColor3 = COLOR_CREAM; box.BorderSizePixel = 0
	box.Text = initial or ""; box.PlaceholderText = placeholder or ""
	box.TextColor3 = COLOR_BROWN; box.PlaceholderColor3 = COLOR_PEANUT_DARK
	box.Font = Enum.Font.Gotham; box.TextSize = 11
	box.ClearTextOnFocus = false; box.ZIndex = 9; box.Parent = parent
	Instance.new("UICorner", box).CornerRadius = UDim.new(0,5)
	box.FocusLost:Connect(function() if onEnter then onEnter(box.Text) end end)
	return y + 26
end

local function mkButton(parent, text, y, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1,-16,0,24); btn.Position = UDim2.new(0,8,0,y)
	btn.BackgroundColor3 = COLOR_PEANUT; btn.BorderSizePixel = 0
	btn.Text = text; btn.TextColor3 = COLOR_BROWN
	btn.Font = Enum.Font.GothamBold; btn.TextSize = 11
	btn.AutoButtonColor = false; btn.ZIndex = 9; btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,5)
	btn.MouseButton1Click:Connect(onClick)
	return y + 28
end

local function mkDropdown(parent, options, y, onChange)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1,-16,0,22); btn.Position = UDim2.new(0,8,0,y)
	btn.BackgroundColor3 = COLOR_PEANUT; btn.BorderSizePixel = 0
	btn.Text = "▶ " .. options[1]; btn.TextColor3 = COLOR_BROWN
	btn.Font = Enum.Font.GothamBold; btn.TextSize = 11
	btn.AutoButtonColor = false; btn.ZIndex = 9; btn.Parent = parent
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,5)
	local idx = 1
	btn.MouseButton1Click:Connect(function()
		idx = idx + 1
		if idx > #options then idx = 1 end
		btn.Text = "▶ " .. options[idx]
		if onChange then onChange(options[idx]) end
	end)
	return y + 26
end

