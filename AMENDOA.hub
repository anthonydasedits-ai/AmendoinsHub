local function selectTab(index)
	for i, tab in ipairs(tabList) do
		local selected = (i == index)
		tab.frame.Visible = selected
		if tab.button then
			tab.button.BackgroundColor3 = selected and COLOR_HIGHLIGHT or COLOR_PEANUT
			tab.button.TextColor3 = selected and COLOR_PEANUT_DARK or COLOR_BROWN
		end
	end
end
