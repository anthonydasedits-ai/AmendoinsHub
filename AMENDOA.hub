local RARITY_SCORE = {
	["Light & Dark"] = 1300, ["Titan"] = 1100, ["Divine"] = 1000,
	["Transcendent"] = 1000, ["Superior"] = 1000, ["Eternal"] = 900,
	["Limited"] = 900, ["Secret"] = 800, ["Exotic"] = 800,
	["Cosmic"] = 700, ["Exclusive"] = 700, ["Admin"] = 700,
	["Mythic"] = 600, ["Mythical"] = 600, ["Prismatic"] = 600,
	["Rainbow"] = 600, ["Squishy God"] = 600, ["BrainrotGod"] = 600,
	["Legendary"] = 500, ["Epic"] = 400, ["Rare"] = 300,
	["SuperRare"] = 200, ["Celestial"] = 200, ["Uncommon"] = 200,
	["Basic"] = 100, ["Common"] = 100,
}

local RARITY_COLOR = {
	["Light & Dark"] = Color3.fromRGB(255, 100, 255),
	["Titan"]         = Color3.fromRGB(255, 60, 60),
	["Divine"]        = Color3.fromRGB(255, 240, 120),
	["Transcendent"]  = Color3.fromRGB(180, 200, 255),
	["Superior"]      = Color3.fromRGB(255, 180, 80),
	["Eternal"]       = Color3.fromRGB(120, 220, 255),
	["Limited"]       = Color3.fromRGB(255, 150, 200),
	["Secret"]        = Color3.fromRGB(255, 60, 60),
	["Exotic"]        = Color3.fromRGB(180, 255, 100),
	["Cosmic"]        = Color3.fromRGB(150, 100, 255),
	["Exclusive"]     = Color3.fromRGB(255, 200, 60),
	["Admin"]         = Color3.fromRGB(255, 50, 50),
	["Mythic"]        = Color3.fromRGB(255, 100, 100),
	["Mythical"]      = Color3.fromRGB(255, 100, 100),
	["Prismatic"]     = Color3.fromRGB(255, 150, 255),
	["Rainbow"]       = Color3.fromRGB(255, 180, 100),
	["Legendary"]     = Color3.fromRGB(255, 200, 80),
	["Epic"]          = Color3.fromRGB(180, 100, 255),
	["Rare"]          = Color3.fromRGB(100, 180, 255),
	["Uncommon"]      = Color3.fromRGB(100, 255, 150),
	["Common"]        = Color3.fromRGB(200, 200, 200),
}

local iconCache = {}
local assetInfoCache = {}
local rarityNameCache = {}

local function getAssetInfo(category)
	if not category then return nil end
	if assetInfoCache[category] ~= nil then return assetInfoCache[category] end
	local info = AssetsData and (AssetsData.Directory or AssetsData)[category]
	assetInfoCache[category] = info or false
	return info or nil
end

local function getRarityName(record)
	if not record then return "Common" end
	local uid = record.Uid or record.BoundsCFrame
	if uid and rarityNameCache[uid] then return rarityNameCache[uid] end

	local name
	if record.Rarity then
		local r = record.Rarity
		name = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
	else
		local cat = record.AssetCategory or record.Category or record.Name
		local info = cat and getAssetInfo(cat)
		if info and info.Rarity then
			local r = info.Rarity
			name = type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
		else
			local areaData = AreasData and (AreasData.Directory or AreasData) and (AreasData.Directory or AreasData)[record.AreaId]
			local rarity = areaData and areaData.Rarity
			local rarityId = (type(rarity) == "table" and (rarity._id or rarity.DisplayName or rarity.Name))
				or (type(rarity) == "string" and rarity) or "Common"
			local rInfo = (RarityData and (RarityData.Rarities or RarityData) or {})[rarityId] or {}
			name = (type(rInfo) == "table" and (rInfo.DisplayName or rInfo._id))
				or (type(rarity) == "table" and rarity.DisplayName) or rarityId or "Common"
		end
	end
	name = name or "Common"
	if uid then rarityNameCache[uid] = name end
	return name
end

local function mutationMultiplier(record)
	local multiplier = 1
	local mutations = record.Mutations or record.Mutation
	if type(mutations) == "table" then
		for _, mutation in pairs(mutations) do
			if type(mutation) == "table" then
				multiplier = multiplier * (tonumber(mutation.Multiplier or mutation.Value or mutation.Scale) or 1.5)
			else
				local text = tostring(mutation):lower()
				if text:find("rainbow") then
					multiplier = multiplier * 3
				elseif text:find("gold") then
					multiplier = multiplier * 2
				elseif text:find("silver") then
					multiplier = multiplier * 1.5
				elseif text:find("parasite") or text:find("monstrous") then
					multiplier = multiplier * 5
				else
					multiplier = multiplier * 1.25
				end
			end
		end
	elseif mutations then
		multiplier = multiplier * 1.5
	end
	if record.HasParasite then multiplier = multiplier * 5 end
	return multiplier
end

local function getEggValue(record)
	local category = tostring(record.AssetCategory or record.Category or record.Name or "Egg")
	local info = getAssetInfo(category)

	local raw = tonumber(
		record.Income or record.EarningRate or record.MoneyPerSecond
		or record.MoneyPerSec or record.CashPerSecond or record.CPS
		or record.Money or record.Cash or record.Value or record.Price
	)

	if (not raw or raw <= 0) and type(info) == "table" then
		raw = tonumber(
			info.Income or info.EarningRate or info.MoneyPerSecond
			or info.MoneyPerSec or info.CashPerSecond or info.CPS
			or info.Money or info.Cash or info.ProfileIncome
			or info.SalePrice or info.Price
		)
		if (not raw or raw <= 0) and type(info.Egg) == "table" then
			raw = tonumber(
				info.Egg.Income or info.Egg.EarningRate or info.Egg.MoneyPerSecond
				or info.Egg.Money or info.Egg.Cash or info.Egg.SalePrice
			)
		end
	end
	raw = tonumber(raw) or 0

	local scale = tonumber(record.AssetScale or record.Scale or record.NestScale) or 1
	local value = raw * scale * mutationMultiplier(record)

	if value <= 0 then
		local rarity = getRarityName(record)
		local score = RARITY_SCORE[rarity] or 100
		local area = tonumber(tostring(record.AreaId or ""):match("%d+")) or 50
		value = score * math.max(area, 50) * math.max(scale, 1)
	end
	return value
end

local function formatarValor(v)
	v = tonumber(v) or 0
	if v >= 1e15 then return string.format("%.1fQ", v/1e15)
	elseif v >= 1e12 then return string.format("%.1fT", v/1e12)
	elseif v >= 1e9  then return string.format("%.1fB", v/1e9)
	elseif v >= 1e6  then return string.format("%.1fM", v/1e6)
	elseif v >= 1e3  then return string.format("%.1fK", v/1e3)
	else return string.format("%d", math.floor(v + 0.5)) end
end

local function getRarityColor(rarity)
	return RARITY_COLOR[rarity] or Color3.fromRGB(220, 220, 220)
end

local function GetPetIcon(record)
	if not record then return nil end

	local targetName = record.Pet or record.PetId or record.PetName
		or record.AssetCategory or record.Category or record.Name

	if targetName then
		local c = iconCache[targetName]
		if c ~= nil then return c ~= false and c or nil end
	end

	local result

	local rawIcon = record.Icon or record.PetIcon or record.ImageAsset
		or record.TextureId or record.Thumbnail or record.Image
	if rawIcon then
		result = (type(rawIcon) == "number" or not string.match(tostring(rawIcon), "://"))
			and ("rbxassetid://" .. tostring(rawIcon)) or tostring(rawIcon)
	end

	if not result and targetName and PetsData then
		local pInfo = (PetsData.Directory or PetsData)[targetName]
		if pInfo then
			local img = pInfo.Icon or pInfo.Image or pInfo.AssetId
				or pInfo.TextureId or pInfo.Thumbnail
			if img then
				result = (type(img) == "number" or not string.match(tostring(img), "://"))
					and ("rbxassetid://" .. tostring(img)) or tostring(img)
			end
			if not result and type(pInfo.Pet) == "table" then
				local p2 = pInfo.Pet
				local img2 = p2.Icon or p2.Image or p2.AssetId or p2.TextureId
				if img2 then
					result = (type(img2) == "number" or not string.match(tostring(img2), "://"))
						and ("rbxassetid://" .. tostring(img2)) or tostring(img2)
				end
			end
		end
	end

	if not result and targetName then
		local aInfo = getAssetInfo(targetName)
		if aInfo then
			local img = aInfo.Icon or aInfo.Image or aInfo.AssetId
				or aInfo.TextureId or aInfo.Thumbnail
			if img then
				result = (type(img) == "number" or not string.match(tostring(img), "://"))
					and ("rbxassetid://" .. tostring(img)) or tostring(img)
			end
			if not result and type(aInfo.Egg) == "table" then
				local e = aInfo.Egg
				local img2 = e.Icon or e.Image or e.AssetId or e.TextureId
				if img2 then
					result = (type(img2) == "number" or not string.match(tostring(img2), "://"))
						and ("rbxassetid://" .. tostring(img2)) or tostring(img2)
				end
			end
		end
	end

	if not result and targetName then
		local folders = {
			ReplicatedStorage:FindFirstChild("Assets"),
			ReplicatedStorage:FindFirstChild("Images"),
			ReplicatedStorage:FindFirstChild("Icons"),
			ReplicatedStorage:FindFirstChild("Pets"),
			ReplicatedStorage:FindFirstChild("Sprites"),
		}
		for _, folder in ipairs(folders) do
			if folder then
				local found = folder:FindFirstChild(targetName, true)
				if found and found:IsA("Decal") then
					result = found.Texture
					break
				elseif found and found:IsA("ImageLabel") then
					result = found.Image
					break
				elseif found and found:IsA("StringValue") then
					result = found.Value
					break
				end
			end
		end
	end

	if targetName then
		iconCache[targetName] = result or false
	end
	return result
end

-- =====================================================
-- LÓGICA ESP EGGS
-- =====================================================
local ESPFolder = nil
local activeESP = {}
local espBindingName = "ESP_Ovos_Update"
local espRunning = false

local function criarESP(uid)
	local part = Instance.new("Part")
	part.Name = "ESP_" .. tostring(uid)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Parent = ESPFolder

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "BB"
	billboard.Size = UDim2.new(0, 150, 0, 48)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = maxEspDistance
	billboard.Parent = part

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	container.BackgroundTransparency = 0.25
	container.BorderSizePixel = 0
	container.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = container

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(46, 204, 113)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = container

	local icon = Instance.new("ImageLabel")
	icon.Size = UDim2.new(0, 36, 0, 36)
	icon.Position = UDim2.new(0, 6, 0.5, -18)
	icon.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	icon.BackgroundTransparency = 0.2
	icon.BorderSizePixel = 0
	icon.ScaleType = Enum.ScaleType.Fit
	icon.Image = ""
	icon.Parent = container

	local iconCorner = Instance.new("UICorner")
	iconCorner.CornerRadius = UDim.new(0, 4)
	iconCorner.Parent = icon

	local labelNome = Instance.new("TextLabel")
	labelNome.Size = UDim2.new(1, -52, 0, 13)
	labelNome.Position = UDim2.new(0, 48, 0, 4)
	labelNome.BackgroundTransparency = 1
	labelNome.TextColor3 = Color3.fromRGB(240, 240, 245)
	labelNome.Font = Enum.Font.GothamBold
	labelNome.TextSize = 10
	labelNome.TextStrokeTransparency = 0.5
	labelNome.TextXAlignment = Enum.TextXAlignment.Left
	labelNome.TextTruncate = Enum.TextTruncate.AtEnd
	labelNome.Text = "Ovo"
	labelNome.Parent = container

	local labelRarity = Instance.new("TextLabel")
	labelRarity.Size = UDim2.new(1, -52, 0, 10)
	labelRarity.Position = UDim2.new(0, 48, 0, 17)
	labelRarity.BackgroundTransparency = 1
	labelRarity.TextColor3 = Color3.fromRGB(200, 200, 200)
	labelRarity.Font = Enum.Font.Gotham
	labelRarity.TextSize = 9
	labelRarity.TextStrokeTransparency = 0.5
	labelRarity.TextXAlignment = Enum.TextXAlignment.Left
	labelRarity.TextTruncate = Enum.TextTruncate.AtEnd
	labelRarity.Text = "Common"
	labelRarity.Parent = container

	local labelValor = Instance.new("TextLabel")
	labelValor.Size = UDim2.new(1, -52, 0, 14)
	labelValor.Position = UDim2.new(0, 48, 0, 29)
	labelValor.BackgroundTransparency = 1
	labelValor.TextColor3 = Color3.fromRGB(255, 210, 80)
	labelValor.Font = Enum.Font.GothamBlack
	labelValor.TextSize = 12
	labelValor.TextStrokeTransparency = 0.4
	labelValor.TextXAlignment = Enum.TextXAlignment.Left
	labelValor.Text = "$0"
	labelValor.Parent = container

	return {
		part = part,
		billboard = billboard,
		container = container,
		stroke = stroke,
		icon = icon,
		labelNome = labelNome,
		labelRarity = labelRarity,
		labelValor = labelValor,
		_lastNome = "",
		_lastRarity = "",
		_lastValor = "",
		_lastColor = nil,
		_lastIcon = "",
		_lastMaxDist = -1,
	}
end

local function destruirESP(esp)
	if esp and esp.part then
		esp.part:Destroy()
	end
end

local function atualizarESP()
	if not EggState or not EggState.ReadFieldEggs then return end

	local ok, snapshot = pcall(EggState.ReadFieldEggs)
	if not ok or not snapshot or not snapshot.Records then return end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position
	local maxDistSq = maxEspDistance * maxEspDistance

	local currentUids = {}

	for _, record in ipairs(snapshot.Records) do
		if record.State == "Slot" and record.BoundsCFrame then
			local eggPos = record.BoundsCFrame.Position
			local dx, dy, dz = eggPos.X - myPos.X, eggPos.Y - myPos.Y, eggPos.Z - myPos.Z
			local distSq = dx*dx + dy*dy + dz*dz

			if distSq <= maxDistSq then
				local uid = record.Uid or tostring(record.BoundsCFrame)
				local rarityName = getRarityName(record)

				if targetRarityName == "Todos" or (rarityName:lower() == targetRarityName:lower()) then
					currentUids[uid] = true

					local esp = activeESP[uid]
					if not esp then
						esp = criarESP(uid)
						activeESP[uid] = esp
					end

					esp.part.CFrame = CFrame.new(eggPos)

					local nome = tostring(record.AssetCategory or record.Category or record.Name or "Ovo")
					if esp._lastNome ~= nome then
						esp.labelNome.Text = nome
						esp._lastNome = nome
					end

					if esp._lastRarity ~= rarityName then
						esp.labelRarity.Text = rarityName
						esp._lastRarity = rarityName
					end
					local cor = getRarityColor(rarityName)
					if esp._lastColor ~= cor then
						esp.labelRarity.TextColor3 = cor
						esp.stroke.Color = cor
						esp._lastColor = cor
					end

					local iconAsset = GetPetIcon(record)
					if iconAsset then
						if esp._lastIcon ~= iconAsset then
							esp.icon.Image = iconAsset
							esp._lastIcon = iconAsset
						end
						if not esp.icon.Visible then esp.icon.Visible = true end
					else
						if esp.icon.Visible then esp.icon.Visible = false end
					end

					local valor = getEggValue(record)
					local valorTexto = "$" .. formatarValor(valor)
					if esp._lastValor ~= valorTexto then
						esp.labelValor.Text = valorTexto
						esp._lastValor = valorTexto
					end

					if esp._lastMaxDist ~= maxEspDistance then
						esp.billboard.MaxDistance = maxEspDistance
						esp._lastMaxDist = maxEspDistance
					end
				end
			end
		end
	end

	for uid, esp in pairs(activeESP) do
		if not currentUids[uid] then
			destruirESP(esp)
			activeESP[uid] = nil
		end
	end
end

local function atualizarSeguro()
	local ok, err = pcall(atualizarESP)
	if not ok then warn("[ESP Ovos] " .. tostring(err)) end
end

local espLoopThread = nil

local function iniciarESP()
	if espRunning then return end
	espRunning = true

	if not ESPFolder or not ESPFolder.Parent then
		ESPFolder = Instance.new("Folder")
		ESPFolder.Name = "ESP_ListaOvos"
		ESPFolder.Parent = (gethui and gethui()) or Workspace
	end

	pcall(function()
		RunService:UnbindFromRenderStep(espBindingName)
	end)
	RunService:BindToRenderStep(espBindingName, Enum.RenderPriority.Camera.Value + 1, atualizarSeguro)

	espLoopThread = task.spawn(function()
		while espRunning do
			task.wait(0.1)
			if espRunning then atualizarSeguro() end
		end
	end)
end

local function pararESP()
	if not espRunning then return end
	espRunning = false

	pcall(function()
		RunService:UnbindFromRenderStep(espBindingName)
	end)

	for uid, esp in pairs(activeESP) do
		destruirESP(esp)
		activeESP[uid] = nil
	end

	if ESPFolder then
		ESPFolder:Destroy()
		ESPFolder = nil
	end
end

espEggsToggle.OnChanged(function(state)
	if state then
		iniciarESP()
	else
		pararESP()
	end
end)

