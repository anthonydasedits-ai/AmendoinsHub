local function stSetStatus(txt)
	stStatusLbl.Text = "STATUS: " .. string.upper(tostring(txt))
end

stealCancelBtn.MouseButton1Click:Connect(function()
	stPararLoop()
	stSetStatus("parado")
	stealCancelBtn.Visible = false
end)

stealBtn.MouseButton1Click:Connect(function()
	if stRunning then
		stRunning = false
		stParar()
		stPararLoop()
		stealCancelBtn.Visible = false
		stealBtn.Text = "AUTO STEAL"
		stealBtn.BackgroundColor3 = COLOR_PEANUT_DARK
		stSetStatus("parado")
		return
	end

	stRunning = true
	stealBtn.Text = "PARAR"
	stealBtn.BackgroundColor3 = COLOR_RED

	task.spawn(function()
		while stRunning do
			stSetStatus("procurando top...")
			local alvo = stGetTopEgg()
			if not alvo then
				stTopLbl.Text = "TOP: nenhum"
				task.wait(0.5)
				continue
			end
			local nome = tostring(alvo.AssetCategory or alvo.Category or alvo.Name or "Ovo")
			local rar = getRarityName(alvo)
			stTopLbl.Text = "TOP: " .. nome .. " (" .. rar .. ")"
			stSetStatus("indo pro top...")

			local targetUid = alvo.Uid
			local targetPos = alvo.BoundsCFrame and alvo.BoundsCFrame.Position
			if not targetPos or not targetUid then task.wait(0.3); continue end

			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then task.wait(0.3); continue end

			stActive = true
			stBodyVel = Instance.new("BodyVelocity")
			stBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			stBodyVel.P = 1250
			stBodyVel.Velocity = Vector3.zero
			stBodyVel.Parent = hrp

			while stRunning and stActive do
				local c = LocalPlayer.Character
				local h = c and c:FindFirstChild("HumanoidRootPart")
				if not h or not stBodyVel or not stBodyVel.Parent then break end
				local found = false
				local ok, snap = pcall(EggState.ReadFieldEggs)
				if ok and snap and snap.Records then
					for _, rec in ipairs(snap.Records) do
						if rec.Uid == targetUid and rec.BoundsCFrame then
							targetPos = rec.BoundsCFrame.Position
							found = true
							break
						end
					end
				end
				if not found then break end
				local myPos = h.Position
				local horiz = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
				local dist = horiz.Magnitude
				if dist < 1 then break end
				local dir = horiz.Unit
				local speed = dist < 6 and math.max(30, dist * 30) or 250
				stBodyVel.Velocity = Vector3.new(dir.X * speed, 0, dir.Z * speed)
				RunService.Heartbeat:Wait()
			end

			if stBodyVel then stBodyVel:Destroy(); stBodyVel = nil end
			local h2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if h2 then h2.Velocity = Vector3.zero end
			if not stRunning then break end

			stSetStatus("pegando...")
			local prompt = stAcharPrompt(targetPos)
			if prompt then
				local done = false
				local conn
				conn = prompt.Triggered:Connect(function(plr) if plr == LocalPlayer then done = true end end)
				pcall(function() prompt:InputHoldBegin() end)
				local holdTime = prompt.HoldDuration or 1.2
				local t0 = tick()
				while not done and (tick() - t0) < (holdTime + 1.5) do
					RunService.Heartbeat:Wait()
				end
				pcall(function() prompt:InputHoldEnd() end)
				if conn then conn:Disconnect() end
			end

			stSetStatus("teleportando...")
			stTeleportar(STEAL_CONFIG.LOOP_POSITION, function(sucesso)
				if sucesso and stRunning then
					stIniciarLoop(STEAL_CONFIG.LOOP_POSITION)
					stealCancelBtn.Visible = true
					stSetStatus("em loop seguro 🥜")
				end
			end)

			stActive = false
			local wt = tick()
			while stRunning and (tick() - wt) < 2 do RunService.Heartbeat:Wait() end
		end

		stRunning = false
		stealBtn.Text = "AUTO STEAL"
		stealBtn.BackgroundColor3 = COLOR_PEANUT_DARK
		stSetStatus("parado")
	end)
end)

task.spawn(function()
	while task.wait(0.5) do
		if stRunning then
			local alvo = stGetTopEgg()
			if alvo then
				local nome = tostring(alvo.AssetCategory or alvo.Category or alvo.Name or "Ovo")
				stTopLbl.Text = "TOP: " .. nome .. " (" .. getRarityName(alvo) .. ")"
			end
		end
	end
end)

-- Auto-reparo em respawn (steal)
local function stHookChar(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(function()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then stLastDeathPos = hrp.Position end
		end)
	end
end
if LocalPlayer.Character then stHookChar(LocalPlayer.Character) end

LocalPlayer.CharacterAdded:Connect(function(char)
	stHookChar(char)
	if stLoopActive then
		if stLoopConn then stLoopConn:Disconnect(); stLoopConn = nil end
		local alvoRetorno = stLastDeathPos or stLoopPos
		task.wait(STEAL_CONFIG.RESPAWN_WAIT)
		if not stLoopActive then return end
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hrp then return end
		stTweenPara(alvoRetorno, STEAL_CONFIG.RESPAWN_TWEEN_TIME, function()
			if stLoopActive and stLoopPos then stIniciarLoop(stLoopPos) end
		end)
	end
end)

-- =====================================================
-- LÓGICA BYPASS
-- =====================================================
local bypassActive = false
local bypassApplied = false

local function aplicarBypass()
	if bypassApplied then return true, 0 end
	if typeof(getgc) ~= "function" then
		warn("[BYPASS] getgc indisponível neste executor.")
		return false
	end

	local aplicados = 0
	local ok, err = pcall(function()
		for _, obj in getgc(true) do
			if typeof(obj) ~= "table" or getrawmetatable(obj) then continue end
			local mainrun = false
			for _, v in obj do
				if v == obj then mainrun = true break end
			end
			if not mainrun then continue end
			for _, v in obj do
				if typeof(v) == "number" and v >= 1 and v <= 3 and obj[v] == nil then
					setmetatable(obj, {__newindex = function() end})
					aplicados = aplicados + 1
					break
				end
			end
		end
	end)

	if not ok then
		warn("[BYPASS] erro: " .. tostring(err))
		return false
	end

	bypassApplied = true
	return true, aplicados
end

