local function selectTab(index)
	for i, tab in ipairs(tabList) do
		local btn = tab.button
		if btn then
			local sel = (i == index)
			tab.frame.Visible = sel
			btn.BackgroundColor3 = sel and COLOR_HIGHLIGHT or COLOR_PEANUT
			btn.TextColor3 = sel and COLOR_PEANUT_DARK or COLOR_BROWN
		end
	end
end

