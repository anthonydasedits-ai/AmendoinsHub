local function addMsg(msg, color)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1,-4,0,18); l.BackgroundTransparency = 1
	l.Text = msg; l.TextColor3 = color or COLOR_PEANUT_DARK
	l.Font = Enum.Font.Gotham; l.TextSize = 10; l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left; l.ZIndex = 10; l.Parent = hopScroll
	table.insert(listItems, l)
	hopScroll.CanvasSize = UDim2.new(0,0,0,#listItems*20)
end
local function setStatus(t, c) hopStatus.Text = t; hopStatus.TextColor3 = c or COLOR_PEANUT_DARK end

local function fetchServers()
	local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local ok, raw = httpGet(url)
	if not ok or not raw then return nil end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 or not data or not data.data then return nil end
	local cur = tostring(game.JobId)
	local out = {}
	for _, s in ipairs(data.data) do
		if s.id and tostring(s.id) ~= cur and s.playing < s.maxPlayers then
			table.insert(out, {id=tostring(s.id), playing=s.playing or 0, maxPlayers=s.maxPlayers or 0})
		end
	end
	table.sort(out, function(a,b) return a.playing < b.playing end)
	return out
end

local function verificarVaga(id)
	local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
	local ok, raw = httpGet(url)
	if not ok or not raw then return false end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 or not data or not data.data then return false end
	for _, s in ipairs(data.data) do
		if tostring(s.id) == tostring(id) then
			return (s.playing or 0) < (s.maxPlayers or 0), {id=tostring(s.id),playing=s.playing or 0,maxPlayers=s.maxPlayers or 0}
		end
	end
	return false
end

local function aplicarFiltro(lista)
	local opt = hopFiltroOpts[hopFiltroIdx]
	local out = {}
	for _, s in ipairs(lista) do if s.playing <= opt.max then table.insert(out, s) end end
	return out
end

local function renderServers(lista)
	clearList()
	if not lista or #lista == 0 then addMsg("Nenhum server.", COLOR_RED); return end
	for _, s in ipairs(lista) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1,-4,0,18); row.BackgroundColor3 = COLOR_PEANUT
		row.BackgroundTransparency = 0.25; row.BorderSizePixel = 0
		row.ZIndex = 10; row.Parent = hopScroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0,4)
		local info = Instance.new("TextLabel")
		info.Size = UDim2.new(1,-50,1,0); info.Position = UDim2.new(0,5,0,0)
		info.BackgroundTransparency = 1; info.Text = string.format("%d/%d", s.playing, s.maxPlayers)
		info.TextColor3 = COLOR_BROWN; info.Font = Enum.Font.GothamBold
		info.TextSize = 10; info.TextXAlignment = Enum.TextXAlignment.Left
		info.ZIndex = 10; info.Parent = row
		local jb = Instance.new("TextButton")
		jb.Size = UDim2.new(0,40,0,14); jb.Position = UDim2.new(1,-44,0.5,-7)
		jb.BackgroundColor3 = COLOR_PEANUT_DARK; jb.BorderSizePixel = 0
		jb.Text = "JOIN"; jb.TextColor3 = COLOR_HIGHLIGHT
		jb.Font = Enum.Font.GothamBold; jb.TextSize = 9
		jb.AutoButtonColor = false; jb.ZIndex = 10; jb.Parent = row
		Instance.new("UICorner", jb).CornerRadius = UDim.new(0,4)
		jb.MouseButton1Click:Connect(function()
			jb.Text = "..."
			local v, d = verificarVaga(s.id)
			if not v then jb.Text = "CHEIO"; task.wait(1.5); jb.Text = "JOIN"; return end
			pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, d.id, LocalPlayer) end)
		end)
		table.insert(listItems, row)
	end
	hopScroll.CanvasSize = UDim2.new(0,0,0,#lista*20)
end

btnFiltro.MouseButton1Click:Connect(function()
	hopFiltroIdx = hopFiltroIdx + 1
	if hopFiltroIdx > #hopFiltroOpts then hopFiltroIdx = 1 end
	btnFiltro.Text = "Filtro: " .. hopFiltroOpts[hopFiltroIdx].label
	if #currentServers > 0 then renderServers(aplicarFiltro(currentServers)) end
end)

btnEnter.MouseButton1Click:Connect(function()
	btnEnter.Text = "Procurando..."
	local lista = fetchServers()
	if not lista or #lista == 0 then setStatus("Nenhum server.", COLOR_RED); btnEnter.Text = "Entrar no Melhor"; return end
	local f = aplicarFiltro(lista); if #f == 0 then f = lista end
	local t = 0
	for _, s in ipairs(f) do
		if t >= 5 then break end
		t = t + 1
		local v, d = verificarVaga(s.id)
		if v and d then
			pcall(function() TeleportService:TeleportToPlaceInstance(PlaceId, d.id, LocalPlayer) end)
			break
		end
	end
	btnEnter.Text = "Entrar no Melhor"
end)

btnLista.MouseButton1Click:Connect(function()
	local lista = fetchServers()
	if not lista or #lista == 0 then setStatus("Nenhum server.", COLOR_RED); return end
	currentServers = lista
	renderServers(aplicarFiltro(lista))
end)

-- =====================================================
-- AUTO TREADMILL
-- =====================================================
local TreadmillUtil, TreadmillRemotes, PlotState
pcall(function() TreadmillUtil = require(ReplicatedStorage.Shared.Util.TreadmillUtil) end)
pcall(function() TreadmillRemotes = require(ReplicatedStorage.Shared.Remotes) end)
pcall(function() PlotState = require(ReplicatedStorage.Client.PlotState) end)

local tmAlive, tmFlying, tmTraining, tmBeltOn = true, false, false, false
local tmRoot = function() local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local tmHum = function() local c = LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end

local function tmWalkSpeed()
	local h = tmHum()
	local sp = (h and h.WalkSpeed) or 16
	if TreadmillUtil then
		local ok, r = pcall(function()
			local ls = LocalPlayer:FindFirstChild("leaderstats")
			local st = ls and ls:FindFirstChild("Speed")
			return st and TreadmillUtil.SpeedPowerToWalkSpeed(st.Value) or nil
		end)
		if ok and type(r) == "number" and r > 0 then sp = math.min(sp, r) end
	end
	return sp
end

local function tmFrozenCam()
	local cam = workspace.CurrentCamera
	if not cam then return function() end end
	local done, old, cf = false, cam.CameraType, cam.CFrame
	pcall(function() cam.CameraType = Enum.CameraType.Scriptable; cam.CFrame = cf end)
	return function() if not done then done = true; pcall(function() cam.CameraType = old end) end end
end

local function tmMySlot()
	if PlotState and type(PlotState.ResolveLocalSlot) == "function" then
		local ok, s = pcall(PlotState.ResolveLocalSlot)
		if ok and type(s) == "number" then return s end
	end
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return nil end
	for _, p in ipairs(plots:GetChildren()) do
		local sign = p:FindFirstChild("PlotSign")
		sign = sign and sign:FindFirstChild("PlayerPlotSign")
		local f = sign and sign:FindFirstChild("Frame")
		local n = f and f:FindFirstChild("PlayerName")
		if n and n:IsA("TextLabel") and (n.Text == LocalPlayer.DisplayName or n.Text == LocalPlayer.Name) then
			return tonumber(p.Name)
		end
	end
end

local function tmSpot(slot)
	local renders = workspace:FindFirstChild("__ClientTreadmillRenders")
	local tr = renders and renders:FindFirstChild("TreadmillRender_" .. tostring(slot))
	if tr then
		local r = tr:FindFirstChild("Root", true)
		if r and r:IsA("BasePart") then return r.Position end
	end
	local plot = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(tostring(slot))
	local b = plot and plot:FindFirstChild("TreadmillBottom")
	if b and b:IsA("BasePart") then return Vector3.new(b.Position.X, b.Position.Y + 4, b.Position.Z - 2) end
end

local function tmFlyTo(target, statusFn)
	local h, r = tmHum(), tmRoot()
	if not r or not h then return false end
	local releaseCam = tmFrozenCam()
	local ws = tmWalkSpeed()
	local speed = math.max(ws * 1.15, 8)
	local share = 0.5
	local cruiseY = math.max(r.Position.Y, target.Y + 70)
	statusFn("subindo...")
	local t0 = os.clock()
	while tmAlive and tmFlying and os.clock()-t0 < 15 do
		r, h = tmRoot(), tmHum()
		if not r or not h then break end
		if r.Position.Y >= cruiseY - 2 then break end
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(0, math.min(speed*share, (cruiseY - r.Position.Y)/0.12), 0)
			h:Move(Vector3.zero, false)
		end)
		RunService.Heartbeat:Wait()
	end
	statusFn("voando...")
	local start = os.clock()
	while tmAlive and tmFlying and os.clock()-start < 120 do
		r, h = tmRoot(), tmHum()
		if not r or not h then return false end
		local flat = Vector3.new(target.X - r.Position.X, 0, target.Z - r.Position.Z)
		local dy = target.Y - r.Position.Y
		if flat.Magnitude < 3 and math.abs(dy) < 3 then break end
		local unit = flat.Magnitude > 0.01 and flat.Unit or Vector3.zero
		local vy = math.clamp(dy/0.12, -speed*share, speed*share)
		local horiz = math.sqrt(math.max(speed*speed - vy*vy, 0))
		local v = unit * math.min(horiz, flat.Magnitude/0.05)
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
			if unit.Magnitude > 0 then h:Move(unit, false) end
		end)
		RunService.Heartbeat:Wait()
	end
	releaseCam()
	r = tmRoot()
	if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero; r.AssemblyAngularVelocity = Vector3.zero end) end
	return tmAlive and tmFlying
end

local tmStatusLbl = Instance.new("TextLabel")
tmStatusLbl.Size = UDim2.new(1,-16,0,14); tmStatusLbl.Position = UDim2.new(0,8,0,8)
tmStatusLbl.BackgroundTransparency = 1; tmStatusLbl.Text = "STATUS: PARADO"
tmStatusLbl.TextColor3 = COLOR_BROWN; tmStatusLbl.Font = Enum.Font.GothamBold
tmStatusLbl.TextSize = 11; tmStatusLbl.TextXAlignment = Enum.TextXAlignment.Left
tmStatusLbl.ZIndex = 9; tmStatusLbl.Parent = treadmillContent

local tmSpeedLbl = Instance.new("TextLabel")
tmSpeedLbl.Size = UDim2.new(1,-16,0,14); tmSpeedLbl.Position = UDim2.new(0,8,0,24)
tmSpeedLbl.BackgroundTransparency = 1; tmSpeedLbl.Text = "SPEED: --"
tmSpeedLbl.TextColor3 = COLOR_PEANUT_DARK; tmSpeedLbl.Font = Enum.Font.Gotham
tmSpeedLbl.TextSize = 10; tmSpeedLbl.TextXAlignment = Enum.TextXAlignment.Left
tmSpeedLbl.ZIndex = 9; tmSpeedLbl.Parent = treadmillContent

local tmGoBtn = Instance.new("TextButton")
tmGoBtn.Size = UDim2.new(1,-16,0,34); tmGoBtn.Position = UDim2.new(0,8,0,44)
tmGoBtn.BackgroundColor3 = COLOR_PEANUT_DARK; tmGoBtn.BorderSizePixel = 0
tmGoBtn.Text = "IR P/ TREADMILL"; tmGoBtn.TextColor3 = COLOR_HIGHLIGHT
tmGoBtn.Font = Enum.Font.GothamBold; tmGoBtn.TextSize = 13
tmGoBtn.AutoButtonColor = false; tmGoBtn.ZIndex = 9; tmGoBtn.Parent = treadmillContent
Instance.new("UICorner", tmGoBtn).CornerRadius = UDim.new(0,6)

local function tmSetStatus(t)
	tmStatusLbl.Text = "STATUS: " .. string.upper(tostring(t))
	tmGoBtn.Text = (tmFlying or tmTraining) and "PARAR" or "IR P/ TREADMILL"
	tmGoBtn.BackgroundColor3 = (tmFlying or tmTraining) and COLOR_RED or COLOR_PEANUT_DARK
end

if TreadmillRemotes and TreadmillRemotes.Treadmill and TreadmillRemotes.Treadmill.AssignedBeltShifted then
	TreadmillRemotes.Treadmill.AssignedBeltShifted.OnClientEvent:Connect(function(id)
		tmBeltOn = id ~= nil
		if tmBeltOn then
			tmTraining, tmFlying = true, false
			tmSetStatus("treinando! +" .. tostring(id))
			local h = tmHum(); if h then pcall(function() h.JumpHeight = 0 end) end
		else
			tmTraining = false
			local h = tmHum(); if h then pcall(function() h.JumpHeight = 7.2 end) end
		end
	end)
end

tmGoBtn.MouseButton1Click:Connect(function()
	if tmTraining or tmFlying then
		tmFlying, tmTraining = false, false
		local r = tmRoot()
		if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero end) end
		tmSetStatus("parado"); return
	end
	task.spawn(function()
		local slot = tmMySlot()
		if not slot then tmSetStatus("plot não achado"); return end
		local spot = tmSpot(slot)
		if not spot then tmSetStatus("treadmill não achada"); return end
		tmFlying = true
		tmSetStatus("voando...")
		local ok = tmFlyTo(spot, tmSetStatus)
		if not ok then tmSetStatus("cancelado"); return end
		tmFlying = false
		tmSetStatus("aguardando belt...")
		local t1 = os.clock()
		while tmAlive and not tmBeltOn and os.clock()-t1 < 8 do
			local r, h = tmRoot(), tmHum()
			if r and h then pcall(function() r.AssemblyLinearVelocity = Vector3.zero; h:Move(Vector3.zero, false) end) end
			RunService.Heartbeat:Wait()
		end
		if tmBeltOn then return end
		if TreadmillRemotes and TreadmillRemotes.Treadmill and TreadmillRemotes.Treadmill.AskWearStill then
			local okW, res = pcall(function() return TreadmillRemotes.Treadmill.AskWearStill:InvokeServer() end)
			if okW and res == true then tmTraining = true; tmSetStatus("treinando!") else tmSetStatus("belt negada") end
		end
	end)
end)

task.spawn(function()
	while tmAlive do
		task.wait(1)
		pcall(function()
			local ls = LocalPlayer:FindFirstChild("leaderstats")
			local st = ls and ls:FindFirstChild("Speed")
			if st and tmSpeedLbl.Parent then tmSpeedLbl.Text = "SPEED: " .. formatarValor(st.Value) end
		end)
	end
end)

-- =====================================================
-- AUTO STEAL (StealAnEggAutofarm)
-- =====================================================
do
	local _rp = print
	print = function(...)
		local s = ""
		for i = 1, select("#", ...) do s = s .. tostring(select(i, ...)) .. " " end
		if s:lower():find("discord", 1, true) then return end
		_rp(...)
	end
end

local STEAL_URL = "https://raw.githubusercontent.com/Lutosys/opensrc/refs/heads/main/StealAnEggAutofarm.lua"
local stealLoaded = false

local stealStatus = Instance.new("TextLabel")
stealStatus.Size = UDim2.new(1,-16,0,14); stealStatus.Position = UDim2.new(0,8,0,38)
stealStatus.BackgroundTransparency = 1; stealStatus.Text = "Auto Steal: DESLIGADO"
stealStatus.TextColor3 = COLOR_PEANUT_DARK; stealStatus.Font = Enum.Font.Gotham
stealStatus.TextSize = 10; stealStatus.TextXAlignment = Enum.TextXAlignment.Left
stealStatus.ZIndex = 9; stealStatus.Parent = stealContent

local stealInfo = Instance.new("TextLabel")
stealInfo.Size = UDim2.new(1,-16,0,90); stealInfo.Position = UDim2.new(0,8,0,58)
stealInfo.BackgroundTransparency = 1
stealInfo.Text = "Carrega o autofarm StealAnEgg.\nSe ficar 'pulando' é porque não\ntem mais ovos no servidor."
stealInfo.TextColor3 = COLOR_PEANUT_DARK; stealInfo.Font = Enum.Font.Gotham
stealInfo.TextSize = 9; stealInfo.TextWrapped = true
stealInfo.TextXAlignment = Enum.TextXAlignment.Left
stealInfo.TextYAlignment = Enum.TextYAlignment.Top
stealInfo.ZIndex = 9; stealInfo.Parent = stealContent

local stealToggle = createToggle(stealContent, "Auto Steal", UDim2.new(0,8,0,8))
stealToggle.OnChanged(function(state)
	if not state then
		stealStatus.Text = "Auto Steal: DESLIGADO"
		stealStatus.TextColor3 = COLOR_RED
		return
	end
	if stealLoaded then
		stealStatus.Text = "Auto Steal: já carregado"
		return
	end
	stealLoaded = true
	stealStatus.Text = "Carregando..."
	task.spawn(function()
		local ok, err = pcall(function()
			local body = game:HttpGet(STEAL_URL)
			local fn = loadstring(body)
			if not fn then error("loadstring falhou") end
			fn()
		end)
		if ok then
			stealStatus.Text = "Auto Steal: ATIVO ✔"
			stealStatus.TextColor3 = COLOR_GREEN
		else
			stealLoaded = false
			stealToggle.Set(false)
			stealStatus.Text = "Erro: " .. tostring(err):sub(1,40)
			stealStatus.TextColor3 = COLOR_RED
		end
	end)
end)

-- =====================================================
-- PETS + FILTRO POR VALOR
-- =====================================================
local PET_STEPS = {
	{label="0",v=0},{label="10K",v=1e4},{label="100K",v=1e5},{label="1M",v=1e6},
	{label="10M",v=1e7},{label="100M",v=1e8},{label="1B",v=1e9},{label="10B",v=1e10},
	{label="100B",v=1e11},{label="1T",v=1e12},
}
local petMinIdx = 1
local petFilterOn = false
local petListItems = {}
local petOriginalReadFieldEggs = nil

local petFilterToggle = createToggle(petsContent, "Filtrar por valor", UDim2.new(0,8,0,4))

local petInfoLbl = Instance.new("TextLabel")
petInfoLbl.Size = UDim2.new(1,-16,0,12); petInfoLbl.Position = UDim2.new(0,8,0,36)
petInfoLbl.BackgroundTransparency = 1; petInfoLbl.Text = "0 no mapa | 0 passam"
petInfoLbl.TextColor3 = COLOR_PEANUT_DARK; petInfoLbl.Font = Enum.Font.Gotham
petInfoLbl.TextSize = 10; petInfoLbl.TextXAlignment = Enum.TextXAlignment.Left
petInfoLbl.ZIndex = 9; petInfoLbl.Parent = petsContent

local petMinBtn = Instance.new("TextButton")
petMinBtn.Size = UDim2.new(1,-16,0,20); petMinBtn.Position = UDim2.new(0,8,0,50)
petMinBtn.BackgroundColor3 = COLOR_PEANUT; petMinBtn.BorderSizePixel = 0
petMinBtn.Text = "Valor mín.: 0 (clica p/ mudar)"
petMinBtn.TextColor3 = COLOR_BROWN; petMinBtn.Font = Enum.Font.GothamBold
petMinBtn.TextSize = 11; petMinBtn.AutoButtonColor = false
petMinBtn.ZIndex = 9; petMinBtn.Parent = petsContent
Instance.new("UICorner", petMinBtn).CornerRadius = UDim.new(0,5)

local petScroll = Instance.new("ScrollingFrame")
petScroll.Size = UDim2.new(1,-16,0,230); petScroll.Position = UDim2.new(0,8,0,74)
petScroll.BackgroundColor3 = COLOR_CREAM; petScroll.BackgroundTransparency = 0.15
petScroll.BorderSizePixel = 0; petScroll.ScrollBarThickness = 3
petScroll.ScrollBarImageColor3 = COLOR_PEANUT_DARK
petScroll.CanvasSize = UDim2.new(0,0,0,0); petScroll.ZIndex = 9; petScroll.Parent = petsContent
Instance.new("UICorner", petScroll).CornerRadius = UDim.new(0,5)
local petLayout = Instance.new("UIListLayout")
petLayout.Padding = UDim.new(0,2); petLayout.SortOrder = Enum.SortOrder.LayoutOrder
petLayout.Parent = petScroll

local function petClear()
	for _, it in ipairs(petListItems) do it:Destroy() end
	petListItems = {}
	petScroll.CanvasSize = UDim2.new(0,0,0,0)
end

local function petAddRow(name, rarity, value, passes)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1,-4,0,16)
	row.BackgroundColor3 = passes and COLOR_PEANUT or COLOR_PEANUT_DARK
	row.BackgroundTransparency = passes and 0.35 or 0.72
	row.BorderSizePixel = 0; row.ZIndex = 10; row.Parent = petScroll
	Instance.new("UICorner", row).CornerRadius = UDim.new(0,4)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1,-6,1,0); lbl.Position = UDim2.new(0,4,0,0)
	lbl.BackgroundTransparency = 1
	lbl.Text = string.format("%s • %s • $%s", name, rarity, formatarValor(value))
	lbl.TextColor3 = passes and COLOR_BROWN or COLOR_PEANUT_DARK
	lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 9
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.ZIndex = 10; lbl.Parent = row
	table.insert(petListItems, row)
end

local function petInstallOverride()
	if petOriginalReadFieldEggs then return end
	if not EggState or type(EggState.ReadFieldEggs) ~= "function" then return end
	petOriginalReadFieldEggs = EggState.ReadFieldEggs
	EggState.ReadFieldEggs = function(...)
		local result = petOriginalReadFieldEggs(...)
		if not petFilterOn or not result or not result.Records then return result end
		local minV = PET_STEPS[petMinIdx].v
		if minV <= 0 then return result end
		local kept = {}
		for _, r in ipairs(result.Records) do
			if getEggValue(r) >= minV then table.insert(kept, r) end
		end
		result.Records = kept
		return result
	end
end

local function petRemoveOverride()
	if not petOriginalReadFieldEggs then return end
	if EggState then EggState.ReadFieldEggs = petOriginalReadFieldEggs end
	petOriginalReadFieldEggs = nil
end

task.spawn(function()
	while screenGui.Parent do
		task.wait(1)
		if petsContent.Visible then
			pcall(function()
				if not EggState then return end
				local reader = petOriginalReadFieldEggs or EggState.ReadFieldEggs
				if type(reader) ~= "function" then return end
				local ok, snap = pcall(reader)
				if not ok or not snap or not snap.Records then return end
				local minV = PET_STEPS[petMinIdx].v
				local items, pass = {}, 0
				for _, r in ipairs(snap.Records) do
					if r.State == "Slot" then
						local v = getEggValue(r)
						local nm = tostring(r.AssetCategory or r.Category or r.Name or "?")
						local rar = getRarityName(r)
						local p = v >= minV
						if p then pass = pass + 1 end
						table.insert(items, {nm=nm, rar=rar, v=v, p=p})
					end
				end
				table.sort(items, function(a,b) return a.v > b.v end)
				petClear()
				for _, it in ipairs(items) do petAddRow(it.nm, it.rar, it.v, it.p) end
				petScroll.CanvasSize = UDim2.new(0,0,0,#items*18)
				petInfoLbl.Text = string.format("%d no mapa | %d passam (mín $%s)", #items, pass, PET_STEPS[petMinIdx].label)
			end)
		end
	end
end)

petMinBtn.MouseButton1Click:Connect(function()
	petMinIdx = petMinIdx + 1
	if petMinIdx > #PET_STEPS then petMinIdx = 1 end
	petMinBtn.Text = "Valor mín.: " .. PET_STEPS[petMinIdx].label .. " (clica p/ mudar)"
end)

petFilterToggle.OnChanged(function(state)
	petFilterOn = state
	if state then petInstallOverride() else petRemoveOverride() end
end)

