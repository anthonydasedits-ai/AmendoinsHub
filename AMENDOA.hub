local function tmFmtSpeed(v)
	v = tonumber(v) or 0
	local a = math.abs(v)
	for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if a >= u[1] then
			local s = string.format("%.2f", v / u[1])
			s = s:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
			return s .. u[2]
		end
	end
	return tostring(math.floor(v + 0.5))
end

local function tmSetStatus(txt)
	tmStatusLbl.Text = "STATUS: " .. string.upper(tostring(txt))
	local on = tmFlying or tmTraining
	tmGoBtn.Text = on and "PARAR" or "IR P/ TREADMILL"
	tmGoBtn.BackgroundColor3 = on and COLOR_RED or COLOR_PEANUT_DARK
end
tmSetStatus("parado")

if Remotes and Remotes.Treadmill and Remotes.Treadmill.AssignedBeltShifted then
	tmWatch(Remotes.Treadmill.AssignedBeltShifted.OnClientEvent, function(id)
		tmBeltOn = id ~= nil
		if tmBeltOn then
			tmTraining, tmFlying = true, false
			tmSetStatus("treinando! +" .. tostring(id))
			local h = tmHumanoid()
			if h then pcall(function() h.JumpHeight = 0 end) end
		else
			if tmTraining then tmSetStatus("saiu da treadmill") end
			tmTraining = false
			local h = tmHumanoid()
			if h then pcall(function() h.JumpHeight = 7.2 end) end
		end
	end)
end

local function tmStopAll(msg)
	tmFlying, tmTraining = false, false
	local r, h = tmRoot(), tmHumanoid()
	if r then pcall(function()
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	end) end
	if h then pcall(function()
		h:Move(Vector3.zero, false)
		h.JumpHeight = 7.2
	end) end
	if msg then tmSetStatus(msg) else tmSetStatus("parado") end
end

tmGoBtn.MouseButton1Click:Connect(function()
	if tmTraining or tmFlying then tmStopAll("parado") return end
	task.spawn(function()
		local slot = tmMySlot()
		if not slot then tmSetStatus("plot não achado") return end
		local spot = tmTreadmillSpot(slot)
		if not spot then tmSetStatus("treadmill não achada") return end
		tmFlying = true
		tmSetStatus("plot " .. slot .. " — voando...")
		local okFly, err = tmFlyTo(spot, tmSetStatus)
		if not okFly then tmStopAll(err or "voo cancelado") return end
		tmSetStatus("chegou! aguardando belt...")
		tmFlying = false
		local t1 = os.clock()
		while tmAlive and not tmBeltOn and os.clock() - t1 < 8 do
			local r, h = tmRoot(), tmHumanoid()
			if r and h then pcall(function()
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				h:Move(Vector3.zero, false)
			end) end
			RunService.Heartbeat:Wait()
		end
		if tmBeltOn then return end
		if Remotes and Remotes.Treadmill and Remotes.Treadmill.AskWearStill then
			local okW, res = pcall(function() return Remotes.Treadmill.AskWearStill:InvokeServer() end)
			if okW and res == true then
				tmTraining = true
				tmSetStatus("treinando!")
			else
				tmStopAll("belt negada: " .. tostring(res))
			end
		else
			tmStopAll("Remotes.Treadmill indisponível")
		end
	end)
end)

task.spawn(function()
	while tmAlive do
		task.wait(1)
		if not tmAlive then break end
		pcall(function()
			local ls = LocalPlayer:FindFirstChild("leaderstats")
			local st = ls and ls:FindFirstChild("Speed")
			if st and tmSpeedLbl.Parent then
				tmSpeedLbl.Text = "SPEED: " .. tmFmtSpeed(st.Value)
			end
		end)
	end
end)

task.spawn(function()
	task.wait(3)
	if not tmAlive then return end
	local slot = tmMySlot()
	local spot = slot and tmTreadmillSpot(slot)
	local r = tmRoot()
	if spot and r and (r.Position - spot).Magnitude < 8 then
		tmTraining = true
		tmSetStatus("treinando!")
		local h = tmHumanoid()
		if h then pcall(function() h.JumpHeight = 0 end) end
	end
end)

