local overlayBarTween
local function overlayShow()
	overlayGui.Enabled = true
	if overlayBarTween then overlayBarTween:Cancel() end
	overlayBar.Size = UDim2.new(0, 0, 1, 0)
	overlayBarTween = TweenService:Create(
		overlayBar,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, true),
		{Size = UDim2.new(1, 0, 1, 0)}
	)
	overlayBarTween:Play()
end
local function overlayHide()
	overlayGui.Enabled = false
	if overlayBarTween then overlayBarTween:Cancel(); overlayBarTween = nil end
	overlayBar.Size = UDim2.new(0, 0, 1, 0)
end

local STEAL_CONFIG = {
	LOOP_POSITION      = Vector3.new(615.8, 70.3, -394.2),
	VELOCIDADE_RUN     = 1e15,
	DISTANCIA_CHEGADA  = 4,
	RESPAWN_WAIT       = 1.5,
	RESPAWN_TWEEN_TIME = 1.5,
}

local stActive, stBodyVel = false, nil
local stLoopActive, stLoopConn, stLoopPos = false, nil, nil
local stTweenConn, stLastDeathPos = nil, nil
local stRunning = false
local stRarityCache = {}

local function stPararLoop()
	stLoopActive = false
	if stLoopConn then stLoopConn:Disconnect(); stLoopConn = nil end
	overlayHide()
end

local function stIniciarLoop(posicao)
	stLoopActive = true
	stLoopPos = posicao
	overlayShow()
	if stLoopConn then stLoopConn:Disconnect() end
	stLoopConn = RunService.Heartbeat:Connect(function()
		if not stLoopActive or not stLoopPos then return end
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		if not h then return end
		h.Velocity = Vector3.zero
		h.CFrame = CFrame.new(stLoopPos) * (h.CFrame - h.Position)
	end)
end

local function stTeleportar(destino, callback)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then
		if callback then callback(false) end
		return
	end
	local walkOrig = humanoid.WalkSpeed
	local jumpOrig = humanoid.JumpPower
	humanoid.WalkSpeed = 500
	humanoid.JumpPower = 120
	local done = false
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if done then return end
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		if not h then done = true; return end
		local origem = h.Position
		local delta = destino - origem
		local dist = delta.Magnitude
		if dist <= STEAL_CONFIG.DISTANCIA_CHEGADA then
			h.CFrame = CFrame.new(destino) * (h.CFrame - h.Position)
			h.Velocity = Vector3.zero
			done = true
			return
		end
		local direcao = delta.Unit
		local passo = math.min(STEAL_CONFIG.VELOCIDADE_RUN * dt, dist)
		local novaPos = origem + direcao * passo
		local dirH = Vector3.new(direcao.X, 0, direcao.Z)
		local lookDir = dirH.Magnitude > 0.001 and dirH.Unit or Vector3.new(0, 0, 1)
		h.CFrame = CFrame.lookAt(novaPos, novaPos + lookDir)
		h.Velocity = Vector3.zero
	end)
	local t0 = tick()
	while not done and (tick() - t0) < 5 do RunService.Heartbeat:Wait() end
	if conn then conn:Disconnect() end
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h then humanoid.WalkSpeed = walkOrig; humanoid.JumpPower = jumpOrig end
	if callback then callback(done) end
end

local function stTweenPara(destino, duracao, callback)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		if callback then callback() end
		return
	end
	if stTweenConn then stTweenConn:Disconnect(); stTweenConn = nil end
	local origem = hrp.Position
	local delta = destino - origem
	if delta.Magnitude < 0.5 then
		if callback then callback() end
		return
	end
	local t0 = tick()
	stTweenConn = RunService.Heartbeat:Connect(function()
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		if not h then
			if stTweenConn then stTweenConn:Disconnect(); stTweenConn = nil end
			if callback then callback() end
			return
		end
		local elapsed = tick() - t0
		local alpha = math.min(elapsed / duracao, 1)
		local eased = alpha * alpha * (3 - 2 * alpha)
		local novaPos = origem:Lerp(destino, eased)
		local dirVec = destino - origem
		local dirH = Vector3.new(dirVec.X, 0, dirVec.Z)
		if dirH.Magnitude > 0.01 then
			h.CFrame = CFrame.lookAt(novaPos, novaPos + dirH.Unit)
		else
			h.CFrame = CFrame.new(novaPos) * (h.CFrame - h.Position)
		end
		h.Velocity = Vector3.zero
		if alpha >= 1 then
			if stTweenConn then stTweenConn:Disconnect(); stTweenConn = nil end
			if callback then callback() end
		end
	end)
end

local function stGetTopEgg()
	if not EggState or not EggState.ReadFieldEggs then return nil end
	local ok, snap = pcall(EggState.ReadFieldEggs)
	if not ok or not snap or not snap.Records then return nil end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local myPos = hrp.Position
	local best, bestScore = nil, -1
	for _, rec in ipairs(snap.Records) do
		if rec.State == "Slot" and rec.BoundsCFrame then
			local eggPos = rec.BoundsCFrame.Position
			if (eggPos - myPos).Magnitude <= maxEspDistance then
				local uid = rec.Uid or tostring(rec.BoundsCFrame)
				local score = stRarityCache[uid]
				if not score then
					score = RARITY_SCORE[getRarityName(rec)] or 100
					stRarityCache[uid] = score
				end
				if score > bestScore then bestScore = score; best = rec end
			end
		end
	end
	return best
end

local function stAcharPrompt(refPos)
	if not refPos then return nil end
	local best, bestD = nil, math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt")
			and obj.Name == "CarryAreaEgg"
			and obj.Parent
			and obj.Parent.Name == "SmartPromptPart"
		then
			local d = (obj.Parent.Position - refPos).Magnitude
			if d < bestD then best, bestD = obj, d end
		end
	end
	return best
end

local function stParar()
	stActive = false
	if stBodyVel then stBodyVel:Destroy(); stBodyVel = nil end
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChild("HumanoidRootPart")
	if h then h.Velocity = Vector3.zero end
end

