local function createToggle(parent, text, position)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, -16, 0, 30); frame.Position = position or UDim2.new(0, 8, 0, 8)
	frame.BackgroundTransparency = 1; frame.ZIndex = 5
	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(1, -60, 1, 0); label.BackgroundTransparency = 1
	label.Text = text; label.TextColor3 = COLOR_BROWN; label.Font = Enum.Font.GothamBold
	label.TextSize = 14; label.TextXAlignment = Enum.TextXAlignment.Left; label.ZIndex = 5
	local switch = Instance.new("TextButton", frame)
	switch.Size = UDim2.new(0, 42, 0, 22); switch.Position = UDim2.new(1, -42, 0.5, -11)
	switch.BackgroundColor3 = COLOR_PEANUT_DARK; switch.Text = ""; switch.AutoButtonColor = false; switch.ZIndex = 5
	Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)
	local knob = Instance.new("Frame", switch)
	knob.Size = UDim2.new(0, 18, 0, 18); knob.Position = UDim2.new(0, 2, 0.5, -9)
	knob.BackgroundColor3 = COLOR_HIGHLIGHT; knob.ZIndex = 6
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
	local state, callbacks = false, {}
	local function update()
		switch.BackgroundColor3 = state and COLOR_GREEN or COLOR_PEANUT_DARK
		TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
			Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
		}):Play()
	end
	switch.MouseButton1Click:Connect(function()
		state = not state; update()
		for _, cb in ipairs(callbacks) do task.spawn(cb, state) end
	end)
	return {
		Frame = frame,
		Set = function(v) state = v; update() end,
		Get = function() return state end,
		OnChanged = function(cb) table.insert(callbacks, cb) end,
	}
end

