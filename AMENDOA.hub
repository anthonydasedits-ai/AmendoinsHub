local function httpGet(url)
	if game and game.HttpGet then
		local ok, r = pcall(function() return game:HttpGet(url) end)
		if ok and r and #r > 0 then return true, r end
	end
	local ok2, r2 = pcall(function() return HttpService:GetAsync(url, true) end)
	if ok2 and r2 and #r2 > 0 then return true, r2 end
	return false
end

