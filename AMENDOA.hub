-- =====================================================
-- CORE SPEED / FLY / ANTI-*
-- =====================================================
local newBypassConns = {}
local newBypassCharConn = nil
local CurrentHum = nil

local function forceWalkSpeed(hum)
	if newBypassConns[hum] then newBypassConns[hum]:Disconnect() end
	newBypassConns[hum] = RunService.Heartbeat:Connect(function()
		if hum and hum.Parent then
			if hum.WalkSpeed ~= CRZMem.DesiredSpeed then hum.WalkSpeed = CRZMem.DesiredSpeed end
		elseif newBypassConns[hum] then
			newBypassConns[hum]:Disconnect(); newBypassConns[hum] = nil
		end
	end)
end

local function applyBypass(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local cam = workspace.CurrentCamera
	local animScript = character:FindFirstChild("Animate")
	local jp, jh, hp, mh = humanoid.JumpPower, humanoid.JumpHeight, humanoid.Health, humanoid.MaxHealth
	if animScript and animScript:IsA("LocalScript") then animScript.Disabled = true end
	local anim = humanoid:FindFirstChildOfClass("Animator")
	if anim then for _, t in next, anim:GetPlayingAnimationTracks() do t:Stop(0) end end
	humanoid.Archivable = true
	local nh = humanoid:Clone()
	for _, c in next, nh:GetChildren() do if c:IsA("Animator") then c:Destroy() end end
	humanoid.Name = "_OldHumanoid"
	nh.Name = "Humanoid"
	nh.Parent = character
	local na = Instance.new("Animator"); na.Parent = nh
	nh.WalkSpeed = CRZMem.DesiredSpeed
	nh.JumpPower = jp; nh.JumpHeight = jh; nh.MaxHealth = mh; nh.Health = math.min(hp, mh)
	if cam then cam.CameraSubject = nh end
	humanoid:Destroy()
	if animScript and animScript:IsA("LocalScript") then
		task.wait()
		animScript.Disabled = false
		task.defer(function()
			if animScript.Parent then
				animScript.Disabled = true; task.wait(); animScript.Disabled = false
			end
		end)
	end
	task.defer(function() if nh.Parent then nh:ChangeState(Enum.HumanoidStateType.Running) end end)
	forceWalkSpeed(nh)
	CurrentHum = nh
end

local function setupBypass(char) char:WaitForChild("Humanoid"); task.wait(); applyBypass(char) end

local function startHumanoidClone()
	if newBypassCharConn then newBypassCharConn:Disconnect() end
	newBypassCharConn = LocalPlayer.CharacterAdded:Connect(function(c)
		if CRZMem.SpeedEnabled then task.spawn(setupBypass, c) end
	end)
	if LocalPlayer.Character then task.spawn(setupBypass, LocalPlayer.Character) end
end

local function stopHumanoidClone()
	for hum, c in pairs(newBypassConns) do c:Disconnect() end
	newBypassConns = {}
	if newBypassCharConn then newBypassCharConn:Disconnect(); newBypassCharConn = nil end
end

local gcSpeedConn = nil
local function startGCHook()
	if not getgc or not hookfunction or not islclosure then
		warn("[Amendoin] GC Hook indisponível — usando Humanoid Clone")
		return startHumanoidClone()
	end
	pcall(function()
		for _, f in next, getgc() do
			if typeof(f) == "function" and islclosure(f) then
				local upvs = debug.getupvalues(f)
				local line = debug.info(f, "l")
				if upvs and #upvs == 19 and line == 3 then
					local v7 = debug.getupvalue(f, 2)
					if v7 then
						local orig
						orig = hookfunction(v7, function(p1, p2)
							if p2 and typeof(p2) == "table" then setmetatable(p2, {}) end
							return orig(p1, p2)
						end)
					end
					break
				end
			end
		end
	end)
	if gcSpeedConn then gcSpeedConn:Disconnect() end
	gcSpeedConn = RunService.Heartbeat:Connect(function()
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChild("Humanoid")
		if h then h.WalkSpeed = CRZMem.DesiredSpeed end
	end)
end

local function stopGCHook()
	if gcSpeedConn then gcSpeedConn:Disconnect(); gcSpeedConn = nil end
end

_G.__AmendoinSpeedToggleApply = function()
	if CRZMem.SpeedEnabled then
		if CRZMem.SpeedBypassMethod == "GC Hook Bypass" then startGCHook() else startHumanoidClone() end
	else
		stopHumanoidClone(); stopGCHook()
		if CurrentHum and CurrentHum.Parent then CurrentHum.WalkSpeed = 16 end
	end
end

-- Fly
local FlyBV, FlyBG, FlyConn
local function startFly()
	if FlyConn then FlyConn:Disconnect() end
	if FlyBV then FlyBV:Destroy() end
	if FlyBG then FlyBG:Destroy() end
	local ch = LocalPlayer.Character
	if not ch then return end
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	FlyBG = Instance.new("BodyGyro")
	FlyBG.MaxTorque = Vector3.new(9e9,9e9,9e9); FlyBG.P = 9e4
	FlyBG.CFrame = hrp.CFrame; FlyBG.Parent = hrp
	FlyBV = Instance.new("BodyVelocity")
	FlyBV.MaxForce = Vector3.new(9e9,9e9,9e9); FlyBV.Velocity = Vector3.zero
	FlyBV.Parent = hrp
	FlyConn = RunService.RenderStepped:Connect(function()
		if not CRZMem.FlyEnabled then return end
		local c = LocalPlayer.Character
		local h = c and c:FindFirstChild("HumanoidRootPart")
		if not h then return end
		local cam = workspace.CurrentCamera
		local dir = Vector3.zero
		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end
		if dir.Magnitude > 0 then dir = dir.Unit * CRZMem.FlySpeed end
		if FlyBG and FlyBG.Parent then FlyBG.CFrame = cam.CFrame end
		if FlyBV and FlyBV.Parent then FlyBV.Velocity = dir end
	end)
end

local function stopFly()
	if FlyConn then FlyConn:Disconnect(); FlyConn = nil end
	if FlyBV then FlyBV:Destroy(); FlyBV = nil end
	if FlyBG then FlyBG:Destroy(); FlyBG = nil end
end

_G.__AmendoinFlyToggleApply = function()
	if CRZMem.FlyEnabled then startFly() else stopFly() end
end

-- Loops gerais
RunService.Heartbeat:Connect(function()
	if CRZMem.AntiKnockbackEnabled then
		local c = LocalPlayer.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local hum = c and c:FindFirstChild("Humanoid")
		if hrp and hum then
			if hum.MoveDirection.Magnitude == 0 then
				hrp.Velocity = Vector3.new(0, hrp.Velocity.Y, 0)
			end
			hrp.RotVelocity = Vector3.zero
		end
	end
	if CRZMem.SpeedEnabled and CRZMem.InstantAccelerationEnabled then
		local c = LocalPlayer.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local hum = c and c:FindFirstChild("Humanoid")
		if hrp and hum and hum.MoveDirection.Magnitude > 0 then
			local tv = hum.MoveDirection.Unit * CRZMem.DesiredSpeed
			hrp.AssemblyLinearVelocity = Vector3.new(tv.X, hrp.AssemblyLinearVelocity.Y, tv.Z)
		end
	end
end)

-- Anti Ragdoll
local ragdollJoints, ragConn = {}, nil
local function storeJoints(char)
	ragdollJoints = {}
	for _, j in ipairs(char:GetDescendants()) do
		if j:IsA("Motor6D") then
			ragdollJoints[j.Name] = {Part0=j.Part0, Part1=j.Part1, C0=j.C0, C1=j.C1}
		end
	end
end
local function restoreJoints()
	for name, d in pairs(ragdollJoints) do
		if d.Part0 and d.Part1 and not d.Part0:FindFirstChild(name) then
			local j = Instance.new("Motor6D")
			j.Name = name; j.Part0 = d.Part0; j.Part1 = d.Part1
			j.C0 = d.C0; j.C1 = d.C1; j.Parent = d.Part0
		end
	end
end
LocalPlayer.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid")
	task.wait(0.3)
	storeJoints(char)
	if ragConn then ragConn:Disconnect() end
	ragConn = RunService.RenderStepped:Connect(function()
		if not CRZMem.AntiRagdollEnabled then return end
		if not char.Parent then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then return end
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Seated then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running); restoreJoints() end)
		end
	end)
end)
if LocalPlayer.Character then
	local c = LocalPlayer.Character
	if c:FindFirstChild("Humanoid") then storeJoints(c) end
end

-- Anti Rejoin
if type(hookmetamethod) == "function" and type(getnamecallmethod) == "function" then
	local orig
	orig = hookmetamethod(game, "__namecall", function(self, ...)
		if CRZMem.AntiRejoinEnabled and (type(checkcaller) ~= "function" or not checkcaller()) then
			local m = getnamecallmethod()
			if m == "Kick" and self == LocalPlayer then return nil end
			if (m == "Teleport" or m == "TeleportAsync" or m == "TeleportToPlaceInstance") and self == TeleportService then return nil end
		end
		return orig(self, ...)
	end)
end

-- =====================================================
-- AUTOMATION CORE
-- =====================================================
local Auto = { Remotes=nil, Save=nil, EggState2=nil, Assets2=nil, Trails=nil, PlotState2=nil, Treadmills=nil, loops={} }
local function req(parent, name)
	local c = parent and parent:FindFirstChild(name)
	if not c or not c:IsA("ModuleScript") then return nil end
	local ok, r = pcall(require, c); return ok and r or nil
end
pcall(function()
	local s = ReplicatedStorage:FindFirstChild("Shared")
	local c = ReplicatedStorage:FindFirstChild("Client")
	local d = ReplicatedStorage:FindFirstChild("Data")
	Auto.Remotes    = req(s, "Remotes")
	Auto.Save       = req(s, "Save")
	Auto.EggState2  = req(c, "EggState")
	Auto.Assets2    = req(d, "Assets")
	Auto.Trails     = req(d, "Trails")
	Auto.PlotState2 = req(c, "PlotState")
	Auto.Treadmills = req(d, "Treadmills")
end)

local function aSave() local ok, s = pcall(Auto.Save.Get, LocalPlayer); return ok and s or nil end
local function aInvk(r, ...) if not r then return false end local ok, a = pcall(function() return r:InvokeServer(...) end) return ok, a end
local function aFire(r, ...) if not r then return false end local ok = pcall(function() r:FireServer(...) end) return ok end

local function aSlot()
	if Auto.PlotState2 and type(Auto.PlotState2.ResolveLocalSlot) == "function" then
		local ok, s = pcall(Auto.PlotState2.ResolveLocalSlot)
		return ok and s or nil
	end
	return nil
end

local function aPlaceFrames()
	if not Auto.PlotState2 or not Auto.PlotState2.ResolvePlot then return {} end
	local ok, plot = pcall(Auto.PlotState2.ResolvePlot)
	if not ok or type(plot) ~= "table" or not plot.PetArea or not plot.CenterPoint then return {} end
	local pa, c = plot.PetArea, plot.CenterPoint
	if not pa.Size or not c.CFrame then return {} end
	local out = {}
	for x = -pa.Size.X*0.5+5, pa.Size.X*0.5-5, 7 do
		for z = -pa.Size.Z*0.5+5, pa.Size.Z*0.5-5, 7 do
			local w = pa.CFrame:PointToWorldSpace(Vector3.new(x,1,z))
			table.insert(out, c.CFrame:ToObjectSpace(CFrame.new(w)))
		end
	end
	return out
end

local aPlaceIdx = 1
local function aDoPlaceAll()
	if not Auto.EggState2 then return 0 end
	local s = aSave(); if type(s) ~= "table" or type(s.EggInventory) ~= "table" then return 0 end
	local eggs = {}
	for uid, e in pairs(s.EggInventory) do
		if type(uid) == "string" and type(e) == "table" and e.Placement == nil then table.insert(eggs, uid) end
	end
	local frames = aPlaceFrames()
	if #eggs == 0 or #frames == 0 then return 0 end
	local placed = 0
	for _, uid in ipairs(eggs) do
		pcall(function() if Auto.EggState2.WearEggTool then Auto.EggState2.WearEggTool(uid) end end)
		task.wait(0.12)
		local did = false
		for off = 0, #frames-1 do
			local i = ((aPlaceIdx + off - 1) % #frames) + 1
			local ok, r = pcall(function() return Auto.EggState2.PlantEgg(uid, frames[i]) end)
			if ok and r == true then aPlaceIdx = i + 1; did = true; placed = placed + 1; task.wait(0.2); break end
		end
		if not did then break end
	end
	return placed
end

local function aDoHatch()
	if not Auto.EggState2 then return 0 end
	local s = aSave(); if not s then return 0 end
	local done = 0
	for uid, e in pairs(s.EggInventory or {}) do
		if type(uid) == "string" and type(e) == "table" then
			local ready = true
			if e.Placement == nil and Auto.EggState2.PlantEgg then
				local slot = aSlot()
				local plots = workspace:FindFirstChild("Plots")
				local pos = Vector3.zero
				local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrp then pos = hrp.Position end
				if plots and slot and plots:FindFirstChild(tostring(slot)) then
					local pt = plots[tostring(slot)]:FindFirstChild("CenterPoint") or plots[tostring(slot)]:FindFirstChild("PlotSign")
					if pt and pt:IsA("BasePart") then pos = pt.Position end
				end
				pcall(Auto.EggState2.PlantEgg, uid, CFrame.new(pos + Vector3.new(math.random(-6,6),0,math.random(-6,6))))
				task.wait(0.15)
			elseif Auto.EggState2.IsReadyToHatch then
				local okR, rr = pcall(Auto.EggState2.IsReadyToHatch, uid)
				ready = okR and rr == true
			end
			if ready and Auto.EggState2.BeginHatch then
				local okH, started = pcall(Auto.EggState2.BeginHatch, uid)
				if okH and started == true then
					if Auto.EggState2.FinishHatch then pcall(Auto.EggState2.FinishHatch, uid) end
					done = done + 1
					task.wait(0.2)
				end
			end
		end
	end
	return done
end

local function aDoClaim()
	local r = Auto.Remotes; if not r then return 0 end
	local n = 0
	if r.Codex and r.Codex.AskRedeemAll then
		local ok, res = aInvk(r.Codex.AskRedeemAll); if ok and res == true then n = n + 1 end
	end
	if r.Codex and r.Codex.AskRedeemLimitedEgg then
		local ok, res = aInvk(r.Codex.AskRedeemLimitedEgg); if ok and res == true then n = n + 1 end
	end
	if r.GroupPerk and r.GroupPerk.RedeemPerk then
		local ok, res = aInvk(r.GroupPerk.RedeemPerk); if ok and res == true then n = n + 1 end
	end
	if r.AwayEarnings and r.AwayEarnings.FetchSummary and r.AwayEarnings.AskCollect then
		local okS, sum = aInvk(r.AwayEarnings.FetchSummary)
		if okS and type(sum) == "table" and (tonumber(sum.ClaimableAmount) or 0) > 0 then
			local okC = aInvk(r.AwayEarnings.AskCollect); if okC then n = n + 1 end
		end
	end
	return n
end

local function aDoBase()
	local r = Auto.Remotes
	return r and r.Homestead and r.Homestead.AskBaseTierRaise and aFire(r.Homestead.AskBaseTierRaise) or false
end

local function aDoTm()
	local r = Auto.Remotes; if not r then return false end
	local tm = Auto.Treadmills
	if not (r.Treadmill and r.Treadmill.AskTierRaise and tm and type(tm.GetByUpgradeLevel) == "function") then return false end
	local s = aSave(); if not s then return false end
	local lv = tonumber(s.TreadmillUpgradeLevel) or 0
	local okCfg, nxt = pcall(tm.GetByUpgradeLevel, lv + 1)
	if not okCfg or type(nxt) ~= "table" or not nxt._id then return false end
	if (tonumber(s.Money) or 0) < (tonumber(nxt.Price) or math.huge) then return false end
	local ok, res = aInvk(r.Treadmill.AskTierRaise, nxt._id)
	return ok and res == true
end

_G.__AmendoinEnterAbyss = function()
	local pkgs = ReplicatedStorage:FindFirstChild("Packages")
	local net = pkgs and pkgs:FindFirstChild("Networking")
	local remote = net and net:FindFirstChild("RF/BossEvent/AskEnter")
	if not remote then return false, "remote não achado" end
	local ok, accepted, msg = pcall(function() return remote:InvokeServer() end)
	if not ok then return false, tostring(accepted) end
	if accepted == true then return true, "Entrando no Abyss" end
	return false, tostring(msg or "recusado")
end

_G.__AmendoinStartLoop = function(kind, state)
	if Auto.loops[kind] == state then return end
	Auto.loops[kind] = state
	if not state then return end
	task.spawn(function()
		while Auto.loops[kind] do
			pcall(function()
				if kind == "place" then aDoPlaceAll()
				elseif kind == "hatch" then aDoHatch()
				elseif kind == "claim" then aDoClaim()
				elseif kind == "base"  then aDoBase()
				elseif kind == "tm"    then aDoTm()
				elseif kind == "abyss" then
					if LocalPlayer:GetAttribute("InBossArena") ~= true then
						_G.__AmendoinEnterAbyss()
					end
				elseif kind == "trail" then
					-- Trail buy (por agora no-op para não quebrar)
				end
			end)
			task.wait(kind == "claim" and 30 or (kind == "base" and 15 or (kind == "tm" and 15 or (kind == "abyss" and 2 or 1))))
		end
	end)
end

-- =====================================================
-- AUTO SELL RUNTIME
-- =====================================================
local AutoSellRT = { Shared=nil, Save=nil, Assets=nil, Net=nil, AskWearTool=nil, SellPet=nil }

pcall(function()
	AutoSellRT.Shared = ReplicatedStorage:FindFirstChild("Shared")
	AutoSellRT.Save   = AutoSellRT.Shared and require(AutoSellRT.Shared:FindFirstChild("Save"))
	AutoSellRT.Assets = require(ReplicatedStorage.Data:FindFirstChild("Assets"))
	AutoSellRT.Net    = ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking")
	if AutoSellRT.Net then
		AutoSellRT.AskWearTool = AutoSellRT.Net:FindFirstChild("RF/EggWorld/AskWearTool")
		AutoSellRT.SellPet     = AutoSellRT.Net:FindFirstChild("RE/PetSatchel/SellPet")
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		if not CRZMem.AutoSellEnabled then continue end
		pcall(function()
			if not (AutoSellRT.Save and AutoSellRT.Assets and AutoSellRT.AskWearTool and AutoSellRT.SellPet) then return end
			local data = AutoSellRT.Save.Get()
			if not data or not data.EggInventory then return end
			for uid, egg in next, data.EggInventory do
				if not CRZMem.AutoSellEnabled then break end
				if egg.Placement then continue end
				local info = AutoSellRT.Assets.Directory[egg.AssetCategory]
				if not info then continue end
				local rar = info.Rarity
				if not rar then continue end
				local name = rar.DisplayName or rar.Name or "Unknown"
				if table.find(CRZMem.AutoSellRarities, name) then
					pcall(function() AutoSellRT.AskWearTool:InvokeServer(uid) end)
					task.wait(0.05)
					pcall(function() AutoSellRT.SellPet:FireServer({uid}) end)
					task.wait(0.1)
				end
			end
		end)
	end
end)

