local function selectTab(index)
	for i, tab in ipairs(tabList) do
		local btn = tab.button
		if btn then
			local selected = (i == index)
			tab.frame.Visible = selected
			btn.BackgroundColor3 = selected and COLOR_HIGHLIGHT or COLOR_PEANUT
			btn.TextColor3 = selected and COLOR_PEANUT_DARK or COLOR_BROWN
		end
	end
end

for i, tab in ipairs(tabList) do
