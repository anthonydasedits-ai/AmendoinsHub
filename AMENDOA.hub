	{ label="TODOS", max=999 }, { label="0-1", max=1 }, { label="0-3", max=3 },
	{ label="0-5", max=5 }, { label="0-10", max=10 },
}
local hopFiltroIdx = 1
local currentServers = {}
local listItems = {}

