local ESPFolder = nil
local activeESP = {}
local espBindingName = "ESP_Ovos_Update"
local espRunning = false

local function criarESP(uid)
	local part = Instance.new("Part")
	part.Name = "ESP_" .. tostring(uid)
	part.Anchored = true; part.CanCollide = false
	part.CanQuery = false; part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.1, 0.1, 0.1)
	part.Parent = ESPFolder
	local billboard = Instance.new("BillboardGui", part)
	billboard.Name = "BB"; billboard.Size = UDim2.new(0, 150, 0, 48)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true; billboard.LightInfluence = 0
	billboard.MaxDistance = maxEspDistance
	local container = Instance.new("Frame", billboard)
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	container.BackgroundTransparency = 0.25; container.BorderSizePixel = 0
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 5)
	local stroke = Instance.new("UIStroke", container)
	stroke.Color = Color3.fromRGB(46, 204, 113); stroke.Thickness = 1; stroke.Transparency = 0.3
	local icon = Instance.new("ImageLabel", container)
	icon.Size = UDim2.new(0, 36, 0, 36); icon.Position = UDim2.new(0, 6, 0.5, -18)
	icon.BackgroundColor3 = Color3.fromRGB(30, 30, 40); icon.BackgroundTransparency = 0.2
	icon.BorderSizePixel = 0; icon.ScaleType = Enum.ScaleType.Fit; icon.Image = ""
	Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 4)
	local labelNome = Instance.new("TextLabel", container)
	labelNome.Size = UDim2.new(1, -52, 0, 13); labelNome.Position = UDim2.new(0, 48, 0, 4)
	labelNome.BackgroundTransparency = 1; labelNome.TextColor3 = Color3.fromRGB(240, 240, 245)
	labelNome.Font = Enum.Font.GothamBold; labelNome.TextSize = 10
	labelNome.TextStrokeTransparency = 0.5
	labelNome.TextXAlignment = Enum.TextXAlignment.Left
	labelNome.TextTruncate = Enum.TextTruncate.AtEnd; labelNome.Text = "Ovo"
	local labelRarity = Instance.new("TextLabel", container)
	labelRarity.Size = UDim2.new(1, -52, 0, 10); labelRarity.Position = UDim2.new(0, 48, 0, 17)
	labelRarity.BackgroundTransparency = 1; labelRarity.TextColor3 = Color3.fromRGB(200, 200, 200)
	labelRarity.Font = Enum.Font.Gotham; labelRarity.TextSize = 9
	labelRarity.TextStrokeTransparency = 0.5
	labelRarity.TextXAlignment = Enum.TextXAlignment.Left
	labelRarity.TextTruncate = Enum.TextTruncate.AtEnd; labelRarity.Text = "Common"
	local labelValor = Instance.new("TextLabel", container)
	labelValor.Size = UDim2.new(1, -52, 0, 14); labelValor.Position = UDim2.new(0, 48, 0, 29)
	labelValor.BackgroundTransparency = 1; labelValor.TextColor3 = Color3.fromRGB(255, 210, 80)
	labelValor.Font = Enum.Font.GothamBlack; labelValor.TextSize = 12
	labelValor.TextStrokeTransparency = 0.4
	labelValor.TextXAlignment = Enum.TextXAlignment.Left; labelValor.Text = "$0"
	return {
		part=part, billboard=billboard, container=container, stroke=stroke, icon=icon,
		labelNome=labelNome, labelRarity=labelRarity, labelValor=labelValor,
		_lastNome="", _lastRarity="", _lastValor="", _lastColor=nil, _lastIcon="", _lastMaxDist=-1,
	}
end

local function destruirESP(esp) if esp and esp.part then esp.part:Destroy() end end

local function atualizarESP()
	if not EggState or not EggState.ReadFieldEggs then return end
	local ok, snapshot = pcall(EggState.ReadFieldEggs)
	if not ok or not snapshot or not snapshot.Records then return end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local myPos = hrp.Position
	local maxDistSq = maxEspDistance * maxEspDistance
	local currentUids = {}
	for _, record in ipairs(snapshot.Records) do
		if record.State == "Slot" and record.BoundsCFrame then
			local eggPos = record.BoundsCFrame.Position
			local dx, dy, dz = eggPos.X-myPos.X, eggPos.Y-myPos.Y, eggPos.Z-myPos.Z
			local distSq = dx*dx+dy*dy+dz*dz
			if distSq <= maxDistSq then
				local uid = record.Uid or tostring(record.BoundsCFrame)
				local rarityName = getRarityName(record)
				if targetRarityName == "Todos" or (rarityName:lower() == targetRarityName:lower()) then
					currentUids[uid] = true
					local esp = activeESP[uid]
					if not esp then esp = criarESP(uid); activeESP[uid] = esp end
					esp.part.CFrame = CFrame.new(eggPos)
					local nome = tostring(record.AssetCategory or record.Category or record.Name or "Ovo")
					if esp._lastNome ~= nome then esp.labelNome.Text = nome; esp._lastNome = nome end
					if esp._lastRarity ~= rarityName then esp.labelRarity.Text = rarityName; esp._lastRarity = rarityName end
					local cor = getRarityColor(rarityName)
					if esp._lastColor ~= cor then esp.labelRarity.TextColor3 = cor; esp.stroke.Color = cor; esp._lastColor = cor end
					local iconAsset = GetPetIcon(record)
					if iconAsset then
						if esp._lastIcon ~= iconAsset then esp.icon.Image = iconAsset; esp._lastIcon = iconAsset end
						if not esp.icon.Visible then esp.icon.Visible = true end
					else
						if esp.icon.Visible then esp.icon.Visible = false end
					end
					local valorTexto = "$" .. formatarValor(getEggValue(record))
					if esp._lastValor ~= valorTexto then esp.labelValor.Text = valorTexto; esp._lastValor = valorTexto end
					if esp._lastMaxDist ~= maxEspDistance then esp.billboard.MaxDistance = maxEspDistance; esp._lastMaxDist = maxEspDistance end
				end
			end
		end
	end
	for uid, esp in pairs(activeESP) do
		if not currentUids[uid] then destruirESP(esp); activeESP[uid] = nil end
	end
end

local function atualizarSeguro()
	local ok, err = pcall(atualizarESP)
	if not ok then warn("[ESP Ovos] " .. tostring(err)) end
end

local espLoopThread = nil
local function iniciarESP()
	if espRunning then return end
	espRunning = true
	if not ESPFolder or not ESPFolder.Parent then
		ESPFolder = Instance.new("Folder")
		ESPFolder.Name = "ESP_ListaOvos"
		ESPFolder.Parent = (gethui and gethui()) or Workspace
	end
	pcall(function() RunService:UnbindFromRenderStep(espBindingName) end)
	RunService:BindToRenderStep(espBindingName, Enum.RenderPriority.Camera.Value + 1, atualizarSeguro)
	espLoopThread = task.spawn(function()
		while espRunning do
			task.wait(0.1)
			if espRunning then atualizarSeguro() end
		end
	end)
end

local function pararESP()
	if not espRunning then return end
	espRunning = false
	pcall(function() RunService:UnbindFromRenderStep(espBindingName) end)
	for uid, esp in pairs(activeESP) do destruirESP(esp); activeESP[uid] = nil end
	if ESPFolder then ESPFolder:Destroy(); ESPFolder = nil end
end

espEggsToggle.OnChanged(function(state)
	if state then iniciarESP() else pararESP() end
end)

